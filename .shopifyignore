# This file contains a list of files that will be excluded from Shopify CLI
# operations such as push, pull, dev, etc.

# Source files (built by Vite)
src/*
node_modules/*
dist/*
.vite-hooks/*
bin/*

# Config files
vite.config.ts
tsconfig.json
package.json
package-lock.json

# Merchant-edited settings — the repo copy is defaults only; the live theme
# keeps the values saved by the theme editor. Never deploy or pull this file,
# otherwise pushes overwrite merchant customisation.
config/settings_data.json

# Documentation / repo files
*.md

# Schemas (JSON files for validation)
schemas/*
