{% doc %}
  The `arrow-up-right` icon as a complete inline `<svg>`. Render via the
  `icon` wrapper rather than directly:
  `{% render 'icon', icon: 'arrow-up-right' %}`.

  @param {number} [size] - Width and height in pixels. Defaults to 16.
  @param {string} [icon_class] - Extra CSS classes for the `<svg>`.
{% enddoc %}

{%- assign icon_size = size | default: 16 -%}
{%- assign icon_extra_class = icon_class | default: '' -%}

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  aria-hidden="true"
  class="icon icon-arrow-up-right{% if icon_extra_class != '' %} {{ icon_extra_class }}{% endif %}"
>
  <line x1="7" y1="17" x2="17" y2="7" />
  <polyline points="7 7 17 7 17 17" />
</svg>
