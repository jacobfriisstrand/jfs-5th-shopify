{% doc %}
  Renders a reusable skeleton placeholder.

  @param {string} [class] - Utility classes for sizing/position/visibility.

  @example
  {% render 'skeleton', class: 'h-4 w-16' %}
{% enddoc %}

{% liquid
  assign extra_class = class | default: ''
%}

<span
  aria-hidden="true"
  data-skeleton
  class="block rounded-input bg-foreground/10 animate-pulse {{ extra_class }}"
></span>