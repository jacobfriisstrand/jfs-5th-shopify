{% doc %}
  Renders an event product card for PLP (product list page) grids.
  Three-column layout: image center, date + title left, description + CTA right.

  Resolves the status badge (upcoming / previous) via the event-status
  snippet from the custom.event_start_date / custom.event_end_date
  metafields. A started-but-not-ended event is treated as upcoming. An
  event with no start date renders no badge.

  The date + time line comes from the event-dates snippet (single source
  of truth for event date display). The location comes from the
  event-location snippet (single source of truth for event location
  display) and renders as muted line(s) below the date + time (gap-1),
  right-aligned on desktop like the date.

  @param {product} product - The product to render. Required.
  @param {number} [heading_level] - Heading level for the product title. Defaults to 3.
  @param {string} [cta_text] - CTA button label. Optional. Defaults to 'View event'.

  @example
  {% render 'event-card-plp', product: product, heading_level: 3, cta_text: 'View event' %}
{% enddoc %}

{% liquid
  assign resolved_heading_level = heading_level | default: 3
  assign resolved_cta_text = cta_text | default: 'View event'

  capture event_status
    render 'event-status', product: product
  endcapture
  assign event_status = event_status | strip

  capture event_dates
    render 'event-dates', product: product
  endcapture
  assign event_dates = event_dates | strip

  assign event_has_location = false
  if product.metafields.custom.event_location_address != blank or product.metafields.custom.event_location_additional_info != blank
    assign event_has_location = true
  endif

  assign event_description = product.description | strip_html | truncate: 120
%}

<div class="grid lg:grid-cols-[1fr_2fr_1fr] gap-x-4 gap-y-3">
  {%- comment -%} Image with badge overlay {%- endcomment -%}
  <div class="grid lg:col-start-2 lg:row-span-4">
    {%- if product.featured_image != blank -%}
      <div class="[grid-area:1/1] aspect-video overflow-hidden">
        {% render 'image',
          image: product.featured_image,
          alt_fallback: product.title,
          class: 'h-full w-full object-cover'
        %}
      </div>
    {%- elsif settings.product_fallback_image != blank -%}
      <div class="[grid-area:1/1] aspect-video overflow-hidden">
        {% render 'image',
          image: settings.product_fallback_image,
          alt_fallback: product.title,
          class: 'h-full w-full object-contain'
        %}
      </div>
    {%- endif -%}

    {%- if event_status != 'none' -%}
      <div class="[grid-area:1/1] z-10 p-2">
        {% render 'event-status', product: product, output: 'badge' %}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Date + time + location {%- endcomment -%}
  {%- if event_dates != blank or event_has_location -%}
    <div class="lg:col-start-1 lg:row-start-4 flex flex-col gap-1 mt-auto">
      {%- if event_dates != blank -%}
        <p class="text-2xl lg:text-4xl w-fit lg:ml-auto font-heading leading-none">
          {{ event_dates }}
        </p>
      {%- endif -%}
      {% render 'event-location', product: product, class: 'w-fit lg:ml-auto lg:text-right' %}
    </div>
  {%- endif -%}

  {%- comment -%} Title {%- endcomment -%}
  <div class="col-start-1 row-start-1">
    {% render 'heading', text: product.title, level: resolved_heading_level, class: 'text-2xl lg:ml-auto w-fit' %}
  </div>

  {%- comment -%} Description {%- endcomment -%}
  {%- if event_description != blank -%}
    <p class="lg:col-start-3 text-sm lg:text-base lg:row-start-1 text-balance">{{ event_description }}</p>
  {%- endif -%}

  {%- comment -%} CTA button {%- endcomment -%}
  <div class="lg:col-start-3 lg:row-start-4 mt-auto">
    {% render 'button', text: resolved_cta_text, href: product.url, class: 'w-fit' %}
  </div>
</div>
