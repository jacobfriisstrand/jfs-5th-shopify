{% doc %}
  Renders the PDP media gallery using variant_gallery metaobjects and the shared
  `<swiper-carousel>` behavior used elsewhere in the theme.

  @param {product} product - Product object used to resolve variant-specific media.

  @example
  {% render 'product-gallery', product: product %}
{% enddoc %}

{% liquid
  assign variant = product.selected_or_first_available_variant
  assign variant_galleries = shop.metaobjects.variant_gallery.values
  assign target_color = variant.option1

  assign matched_images = empty
  if variant_galleries != blank and target_color != blank
    for entry in variant_galleries
      assign entry_variant = entry.color.value
      if entry_variant == blank
        continue
      endif
      if entry_variant.product.id != product.id
        continue
      endif
      assign entry_images = entry.images.value
      if entry_variant.option1 == target_color and entry_images.size > 0
        assign matched_images = entry_images
        break
      endif
    endfor
  endif

  if matched_images == empty
    assign matched_images = product.media
  endif

  assign primary = variant.featured_image
  if primary == blank
    assign primary = product.featured_image
  endif

  assign is_product_media_fallback = false
  if matched_images == product.media
    assign is_product_media_fallback = true
  endif

  assign extras_count = 0
  if matched_images != empty
    assign extras_count = matched_images.size
    if is_product_media_fallback and primary != blank
      assign extras_count = extras_count | minus: 1
    endif
  endif

  assign total_count = extras_count
  if primary != blank
    assign total_count = extras_count | plus: 1
  endif

  assign use_carousel = false
  if total_count > 1
    assign use_carousel = true
  endif

  assign gallery_list_class = 'flex flex-col gap-4'
  if use_carousel
    assign gallery_list_class = gallery_list_class | append: ' md:h-[70dvh] md:overflow-hidden md:[&>li]:flex-1 md:[&>li]:min-h-0'
  endif
%}

{%- if total_count > 0 -%}
  {%- if use_carousel -%}
    <swiper-carousel
      data-bundle-url="{{ 'swiper-element-bundle.js' | asset_url }}"
      data-slides-per-view="1"
      data-breakpoints='{"640":{"slidesPerView":1,"spaceBetween":0},"1024":{"slidesPerView":1,"spaceBetween":0},"1280":{"slidesPerView":1,"spaceBetween":0}}'
      data-auto-height="false"
      class="relative block w-full aspect-[3/4] md:h-[70dvh]"
      style="visibility:hidden"
      aria-roledescription="carousel"
      aria-label="{{ 'accessibility.product_images' | t | escape }}"
    >
  {%- endif -%}

  <ul role="list" class="{{ gallery_list_class }}">
    {%- if primary != blank -%}
      <li>
        {% render 'image',
          image: primary,
          priority: 'lcp',
          class: 'h-full w-full object-contain',
          style: 'max-height:70dvh',
          width_max: 1200,
          widths: '400, 600, 800, 1000, 1200',
          sizes: '(min-width: 768px) 50vw, 100vw'
        %}
      </li>
    {%- endif -%}
    {%- if matched_images != empty -%}
      {%- for media in matched_images -%}
        {%- if media.media_type == 'video' -%}
          {%- continue -%}
        {%- endif -%}
        {%- if is_product_media_fallback and primary != blank and media.id == primary.id -%}
          {%- continue -%}
        {%- endif -%}
        <li>
          {% render 'image',
            image: media,
            class: 'h-full w-full object-contain',
            style: 'max-height:70dvh',
            width_max: 1200,
            widths: '400, 600, 800, 1000, 1200',
            sizes: '(min-width: 768px) 50vw, 100vw'
          %}
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>

  {%- if use_carousel -%}
    <div
      class="mt-6 flex justify-end gap-2 sm:mt-8"
      role="group"
      aria-label="{{ 'accessibility.product_gallery_navigation' | t | escape }}"
    >
      <button
        type="button"
        data-carousel-prev
        aria-label="{{ 'content.pagination.previous' | t | escape }}"
        class="border-foreground/20 text-foreground flex h-10 w-10 items-center justify-center rounded-full border transition aria-disabled:cursor-not-allowed aria-disabled:opacity-40"
      >
        <span aria-hidden="true">{% render 'icon', icon: 'arrow-left', size: 16 %}</span>
      </button>
      <button
        type="button"
        data-carousel-next
        aria-label="{{ 'content.pagination.next' | t | escape }}"
        class="border-foreground/20 text-foreground flex h-10 w-10 items-center justify-center rounded-full border transition aria-disabled:cursor-not-allowed aria-disabled:opacity-40"
      >
        <span aria-hidden="true">{% render 'icon', icon: 'arrow-right', size: 16 %}</span>
      </button>
    </div>
    </swiper-carousel>
  {%- endif -%}
{%- else -%}
  {%- if settings.product_fallback_image != blank -%}
    <ul role="list" class="{{ gallery_list_class }}">
      <li>
        {% render 'image',
          image: settings.product_fallback_image,
          class: 'h-full w-full object-contain',
          style: 'max-height:70dvh',
          width_max: 1200,
          widths: '400, 600, 800, 1000, 1200',
          sizes: '(min-width: 768px) 50vw, 100vw'
        %}
      </li>
    </ul>
  {%- else -%}
    {{ 'product-1' | placeholder_svg_tag: 'h-full w-full object-contain bg-foreground/5' }}
  {%- endif -%}
{%- endif -%}
