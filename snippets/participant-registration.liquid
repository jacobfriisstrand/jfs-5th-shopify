{% doc %}
  Renders the participant registration form for event products that carry a
  `custom.participant_fields` metaobject reference.

  Driven by a single `<participant-registration-form>` custom element (see
  `src/scripts/participant-registration-form.ts`). The team vs individual
  distinction is derived from `custom.team_size` — it is the single source of
  truth:

  - `custom.team_size` `1` — a "Register" button that opens a dialog holding
    one participant form (individual registration).
  - `custom.team_size` `> 1` — a "Register team" button that opens a dialog
    holding exactly that many participant accordions (team size is fixed on
    the event; there is no quantity counter).

  Every participant collects the fields configured on the referenced metaobject
  — there are no hard-coded fields. On submit the element batch-adds one cart
  line item per participant (quantity 1), each carrying its own line-item
  properties.

  The drawer also renders a product upsell carousel below the form, sourced
  from the merchant's custom "all products" collection (handle
  `all-products`), capped at 8 items.

  @param {object} product - The product. Required.
  @param {object} section - The parent section (for scoped ids). Required.
  @param {object} variant - The selected/available variant. Required.

  @example
  {% render 'participant-registration', product: product, section: section, variant: variant %}
{% enddoc %}

{% liquid
  assign registration = product.metafields.custom.participant_fields.value
  assign fields = registration.fields.value

  assign variant = variant | default: product.selected_or_first_available_variant

  # Team size is the sole discriminator: 1 = individual registration, > 1 =
  # team registration. It is fixed on the event — no quantity counter — and
  # the form always renders exactly this many participant fieldsets.
  assign team_size = product.metafields.custom.team_size | default: 1
  if team_size == blank or team_size < 1
    assign team_size = 1
  endif

  # Single-person events (team size 1) use generic wording; multi-person teams
  # use team-specific wording.
  if team_size > 1
    assign submit_text = 'sections.event.registration.submit_team' | t
    assign dialog_title_text = 'sections.event.registration.dialog_title' | t
    assign instructions_text = 'sections.event.registration.instructions' | t
  else
    assign submit_text = 'sections.event.registration.submit_individual' | t
    assign dialog_title_text = 'sections.event.registration.submit_individual' | t
    assign instructions_text = 'sections.event.registration.instructions_single' | t
  endif

  assign submit_disabled = false
  if variant.available == false
    assign submit_disabled = true
    assign submit_text = 'blocks.sold_out' | t
  endif

  assign label_participant = 'sections.event.registration.participant' | t
  assign label_your_information = 'sections.event.registration.your_information' | t
  assign label_close = 'accessibility.close_dialog' | t
  assign label_add_to_cart = 'products.product.add_to_cart' | t

  assign input_class = 'rounded-input border border-current/30 bg-transparent px-3 py-2 text-sm'
  assign label_class = 'text-foreground/70 text-sm font-medium'

  assign dialog_id = 'registration-dialog-' | append: section.id
  assign dialog_title_id = dialog_id | append: '-title'
  assign register_attrs = 'data-register-trigger aria-haspopup="dialog" aria-controls="' | append: dialog_id | append: '"'

  assign upsell_collection = collections['all-products']
  assign upsell_products = upsell_collection.products
  assign upsell_products_count = upsell_collection.products_count
  if upsell_products_count > 8
    assign upsell_products_count = 8
  endif
  assign upsell_title_text = 'sections.event.registration.upsell_title' | t
  assign upsell_heading_id = dialog_id | append: '-upsell-title'
  assign upsell_breakpoints = '{"768": {"slidesPerView": 2, "spaceBetween": 16}}'
%}

{%- if registration != blank -%}
  <participant-registration-form
    data-team-size="{{ team_size }}"
    data-variant-id="{{ variant.id }}"
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
  >
    <div class="flex flex-col gap-4">
      {%- if team_size > 1 -%}
        <p class="text-foreground text-md">
          {{ 'sections.event.registration.team_count' | t: count: team_size }}
        </p>
      {%- endif -%}

      {% render 'button',
        text: submit_text,
        variant: 'noIcon',
        class: 'w-full',
        disabled: submit_disabled,
        attrs: register_attrs
      %}
    </div>

    {%- capture dialog_body -%}
      <div class="flex h-full flex-col">
        <header class="flex items-center justify-between gap-4 border-b border-current/15 p-4">
          {% render 'heading', text: dialog_title_text, level: 2, id: dialog_title_id, class: 'text-lg font-medium' %}
          {% render 'drawer-close-button', label: label_close %}
        </header>
        <div class="flex flex-1 flex-col gap-4 overflow-y-auto p-4">
          <p class="text-foreground/70 text-sm">{{ instructions_text }}</p>
          <form on:submit="participant-registration-form/handleSubmit" novalidate class="flex flex-col gap-4">
            <div data-participants class="accordion-group"></div>
            {% render 'button',
              text: label_add_to_cart,
              variant: 'noIcon',
              type: 'submit',
              class: 'w-full',
              ref: 'submitButton'
            %}
          </form>

          {%- if upsell_products_count > 0 -%}
            <section class="mt-2 border-t border-current/15 pt-6" aria-labelledby="{{ upsell_heading_id }}">
              {% render 'carousel',
                type: 'product',
                items: upsell_products,
                count: upsell_products_count,
                min_for_carousel: 3,
                slides_per_view: '1.2',
                breakpoints: upsell_breakpoints,
                heading: upsell_title_text,
                heading_level: 3,
                heading_id: upsell_heading_id,
                heading_class: 'text-xl'
              %}
            </section>
          {%- endif -%}
        </div>
      </div>
    {%- endcapture -%}

    {% render 'drawer',
      id: dialog_id,
      side: 'right',
      class: 'p-0 drawer-responsive-bottom',
      aria_labelledby: dialog_title_id,
      content: dialog_body
    %}

    <template>
      <details class="accordion-row">
        <summary>
          {%- if team_size > 1 -%}
            <span class="text-base font-medium">
              {{- label_participant }}
              <span data-participant-number>1</span></span
            >
          {%- else -%}
            <span class="text-base font-medium">{{ label_your_information }}</span>
          {%- endif -%}
        </summary>

        <div class="flex flex-col gap-4">
          {%- for field in fields -%}
            {%- if field.label != blank -%}
              <div class="flex flex-col gap-1.5">
                <label for="reg-opt-{{ forloop.index0 }}" class="{{ label_class }}">{{ field.label | escape }}</label>
                <input
                  id="reg-opt-{{ forloop.index0 }}"
                  type="text"
                  data-property="{{ field.label | escape }}"
                  data-role="{{ field.role.value | default: field.role | escape }}"
                  {%- if field.required == true or field.required == 'true' %}
                    required aria-required="true"
                  {% endif -%}
                  class="{{ input_class }}"
                >
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </details>
    </template>
  </participant-registration-form>
{%- endif -%}
