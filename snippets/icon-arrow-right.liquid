{% doc %}
  Right arrow icon for carousel next buttons.
  `{% render 'icon', icon: 'arrow-right' %}`.

  @param {number} [size] - Width and height in pixels. Defaults to 16.
  @param {string} [icon_class] - Extra CSS classes for the `<svg>`.
{% enddoc %}

{%- assign icon_size = size | default: 16 -%}
{%- assign icon_extra_class = icon_class | default: '' -%}

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  focusable="false"
  aria-hidden="true"
  class="icon icon-arrow-right{% if icon_extra_class != '' %} {{ icon_extra_class }}{% endif %}"
>
  <line x1="5" y1="12" x2="19" y2="12" />
  <polyline points="12 5 19 12 12 19" />
</svg>
