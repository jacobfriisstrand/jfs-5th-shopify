{% doc %}
  Renders the cart line-item list (image, title, variant title, quantity
  selector, line price, remove button) for either the `/cart` page or the
  cart drawer.

  This is the single source of truth for cart line-item rendering, per
  ADR-0005. The snippet does NOT render its own `<form>` — the caller is
  responsible for wrapping it (and any sibling summary block) in
  `<form action="{{ routes.cart_url }}" method="post">` so the JS-disabled
  contract works: per-line `name="updates[<key>]"` inputs are posted to
  `/cart`, which updates quantities and redirects back.

  @param {object} cart - The current cart. Required.

  @example
  {% render '_cart-line-items', cart: cart %}
{% enddoc %}

<ul role="list" class="flex flex-col divide-y divide-current/15">
  {% for line in cart.items %}
    {% liquid
      assign qty_id = 'cart-qty-' | append: line.key
      assign qty_name = 'updates[' | append: line.key | append: ']'
      assign remove_label = 'accessibility.remove_item' | t: title: line.product.title
      assign participant_name = line.properties._name
      assign participant_email = line.properties._email
      assign is_participant_line = false
      if line.properties._participant != blank
        assign is_participant_line = true
      endif
      assign is_team_line = false
      if line.properties._team_size != blank
        assign is_team_line = true
      endif
      assign has_line_discount = false
      if line.original_line_price > line.final_line_price
        assign has_line_discount = true
      endif
    %}
    <li
      class="group flex min-h-40 gap-4 py-4"
      data-cart-line="{{ forloop.index }}"
    >
      <a href="{{ line.url }}">
        {%- if line.image -%}
          {% render 'image',
            image: line.image,
            width: line.image.width,
            height: line.image.height,
            width_max: 200,
            widths: '100, 200, 400',
            sizes: '(min-width: 640px) 96px, 80px',
            class: 'rounded-input size-full object-cover',
            alt: line.product.title
          %}
        {%- endif -%}
      </a>

      <div class="flex flex-1 flex-col gap-2">
        <div class="flex items-start justify-between gap-3">
          <div class="flex min-w-0 flex-col gap-1">
            <a href="{{ line.url }}" class="text-foreground text-sm font-medium truncate hover:underline sm:text-base">
              {{ line.product.title }}
            </a>
            {%- unless line.product.has_only_default_variant -%}
              <p class="text-foreground/70 text-xs truncate">{{ line.variant.title }}</p>
            {%- endunless -%}
            {%- if is_team_line -%}
              <p class="text-foreground/70 text-xs truncate">
                {{ 'sections.event.registration.participant' | t }}
                {{ line.properties._participant }}
              </p>
            {%- endif -%}
            {%- if participant_name != blank -%}
              <p class="text-foreground/70 text-xs truncate">{{ participant_name | escape }}</p>
            {%- endif -%}
            {%- if participant_email != blank -%}
              <p class="text-foreground/70 text-xs truncate">{{ participant_email | escape }}</p>
            {%- endif -%}
            {%- if line.selling_plan_allocation -%}
              <p class="text-foreground/70 text-xs">{{ line.selling_plan_allocation.selling_plan.name }}</p>
            {%- endif -%}
            {% render '_bundle-offer-pill', product: line.product %}
          </div>
          <p class="text-foreground flex flex-col items-end gap-0.5 text-sm font-medium sm:text-base">
            <span class="flex flex-col group-data-[updating=true]:hidden whitespace-nowrap">
              {%- if has_line_discount -%}
                <span class="text-foreground/50 mr-1 line-through">
                  {{- line.original_line_price | money_without_trailing_zeros -}}
                </span>
              {%- endif -%}
              {{ line.final_line_price | money_without_trailing_zeros }}
            </span>
            {% render 'skeleton', class: 'hidden h-4 w-16 align-middle group-data-[updating=true]:inline-block' %}
          </p>
        </div>

        <div class="flex justify-between gap-3 mt-auto items-end">
          {%- unless is_participant_line -%}
            <quantity-selector-component class="inline-block">
              <label for="{{ qty_id }}" class="sr-only">{{ 'accessibility.quantity' | t }}</label>
              {% render 'quantity-input',
                input_id: qty_id,
                value: line.quantity,
                min: 0,
                step: 1,
                name: qty_name,
                cart_line: forloop.index
              %}
            </quantity-selector-component>
          {%- endunless -%}

          <button
            type="submit"
            name="updates[{{ line.key }}]"
            value="0"
            aria-label="{{ remove_label }}"
            class="hover:text-foreground text-foreground/70 text-xs underline-offset-2 hover:underline ml-auto"
          >
            {{ 'actions.remove' | t }}
          </button>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
