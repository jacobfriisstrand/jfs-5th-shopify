{% doc %}
  The `pause` icon as a complete inline `<svg>`. Render via the
  `icon` wrapper rather than directly: `{% render 'icon', icon: 'pause' %}`.

  @param {number} [size] - Width and height in pixels. Defaults to 16.
  @param {string} [icon_class] - Extra CSS classes for the `<svg>`.
{% enddoc %}

{%- assign icon_size = size | default: 16 -%}
{%- assign icon_extra_class = icon_class | default: '' -%}

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="currentColor"
  focusable="false"
  aria-hidden="true"
  class="icon icon-pause{% if icon_extra_class != '' %} {{ icon_extra_class }}{% endif %}"
>
  <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
</svg>
