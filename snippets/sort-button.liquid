{% doc %}
  Renders a single sort toggle button as a hidden radio input + styled label.
  Used inside a `<fieldset role="radiogroup">`. The active state is handled
  by the parent via `input[name]:checked + label` CSS.

  @param {string} id - Unique id for the radio input. Required.
  @param {string} name - Radio group name shared by all sort buttons. Required.
  @param {string} value - Radio value. Required.
  @param {string} text - Label text. Required.
  @param {boolean} [checked] - Whether this radio is checked by default.

  @example
  {% render 'sort-button', id: 'sort-all', name: 'event-sort', value: 'all', text: 'All events (23)', checked: true %}
  {% render 'sort-button', id: 'sort-upcoming', name: 'event-sort', value: 'upcoming', text: 'Upcoming (1)' %}
{% enddoc %}

{% liquid
  assign is_checked = checked | default: false
%}

<input
  type="radio"
  id="{{ id }}"
  name="{{ name }}"
  value="{{ value }}"
  class="hidden"
  {% if is_checked %}checked{% endif %}
>
<label
  for="{{ id }}"
  class="block h-fit text-xs lg:text-sm font-medium whitespace-nowrap select-none rounded-full btn-size--base cursor-pointer border border-foreground/20 transition-colors"
>
  {{- text -}}
</label>
