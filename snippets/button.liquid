{% doc %}
  Renders a `<button>` or `<a>` element with a unified visual style, variant
  support, optional sizes, and built-in loading state.

  @param {string} [text] - Visible label. Required unless `icon` is set.
  @param {string} [icon] - Icon name to render. When set, `variant: 'icon'` is implied.
  @param {number} [icon_size] - Icon size in px. Defaults to 24.
  @param {boolean} [noIcon] - When true, hides the default arrow icon after the text.
  @param {string} [href] - Destination URL. When present, renders an `<a>` element.
  @param {string} [as] - Force element type: `'a'` or `'button'`. Defaults to
    `'button'` unless `href` is supplied.
  @param {string} [type] - `<button>` `type` attribute: `submit`, `button`, or
    `reset`. Defaults to `'button'`. Ignored for anchors.
  @param {string} [variant] - Visual style: `base`, `link`, or `noIcon`.
    Defaults to `base`.
  @param {string} [size] - Size preset: `base` or `large`. Defaults to `base`.
  @param {boolean} [loading] - When true, shows a spinner and blocks interaction.
  @param {boolean} [disabled] - Marks the control as disabled.
  @param {string} [class] - Additional Tailwind classes appended to the element.
  @param {string} [name] - `<button>` `name` attribute for form submission
    routing (e.g. `'checkout'` or `'update'`). Ignored for anchors.
  @param {string} [value] - `<button>` `value` attribute paired with `name`.
    Ignored for anchors.
  @param {string} [aria_label] - Accessible label override for cases where the
    visible text is not descriptive enough.
  @param {string} [id] - Optional `id` attribute.
  @param {string} [ref] - Optional `ref` attribute for use with the `Component` base class.
  @param {string} [attrs] - Raw HTML attributes string rendered on the element.

  @example
  {% render 'button', text: 'Add to cart', variant: 'base', type: 'submit' %}

  @example
  {% render 'button', text: 'Learn more', href: product.url, variant: 'link' %}

  @example
  {% render 'button', text: 'Unavailable', variant: 'base', disabled: true %}

  @example
  {% render 'button', text: 'Learn more', variant: 'base', noIcon: true %}
{% enddoc %}

{% liquid
  assign resolved_variant = variant | default: 'base'
  if resolved_variant == 'link' and size == blank
    assign resolved_size = 'link'
  else
    assign resolved_size = size | default: 'base'
  endif
  assign resolved_type = type | default: 'button'

  assign is_anchor = false
  if href != blank or as == 'a'
    assign is_anchor = true
  endif

  assign is_disabled = false
  if disabled
    assign is_disabled = true
  endif

  assign is_loading = false
  if loading
    assign is_loading = true
  endif

  assign icon_size = icon_size | default: 16
  assign hide_icon = noIcon | default: false

  if resolved_variant == 'link' or resolved_variant == 'noIcon'
    assign hide_icon = true
  endif

  assign base_classes = 'block h-fit font-body font-medium whitespace-nowrap select-none [transition-property:opacity,background-color,border-color] duration-150 group disabled:opacity-50 disabled:pointer-events-none aria-disabled:opacity-50 aria-disabled:pointer-events-none rounded-full'

  case resolved_size
    when 'link'
      assign size_classes = 'btn-size--link'
    when 'large'
      assign size_classes = 'btn-size--large'
    else
      assign size_classes = 'btn-size--base'
  endcase

  if icon != blank
    assign resolved_variant = 'icon'
    assign all_classes = 'p-2 aspect-square inline-flex items-center justify-center'
    if class != blank
      assign all_classes = all_classes | append: ' ' | append: class
    endif
  else

    case resolved_variant
      when 'link'
        assign variant_classes = 'btn-variant--link'
      when 'noIcon'
        assign variant_classes = 'btn-variant--noIcon'
      else
        assign variant_classes = 'btn-variant--base'
    endcase

    assign all_classes = base_classes | append: ' ' | append: size_classes | append: ' ' | append: variant_classes
    if class != blank
      assign all_classes = all_classes | append: ' ' | append: class
    endif
  endif
%}

{%- if is_anchor -%}
  <a
    href="{{ href | default: '#' }}"
    class="{{ all_classes }}"
    {%- if id != blank %} id="{{ id }}"{% endif -%}
    {%- if ref != blank %} ref="{{ ref }}"{% endif -%}
    {%- if attrs != blank %} {{ attrs }}{% endif -%}
    {%- if aria_label != blank %} aria-label="{{ aria_label | escape }}"{% endif -%}
    {%- if is_loading %} aria-busy="true" data-loading=""{% endif -%}
    {%- if is_disabled or is_loading %} aria-disabled="true" tabindex="-1"{% endif -%}
  >
    {%- if icon != blank -%}
      <span class="grid [grid-template-areas:'stack'] place-items-center">
        <span class="[grid-area:stack] group-data-loading:invisible">
          {%- render 'icon', icon: icon, size: icon_size -%}
        </span>
        <span class="[grid-area:stack] size-[1em] rounded-full border-2 border-current border-t-transparent animate-spin invisible group-data-loading:visible" aria-hidden="true"></span>
      </span>
    {%- else -%}
      <span class="grid [grid-template-areas:'stack'] place-items-center">
        <span class="[grid-area:stack] inline-flex items-center gap-2 group-data-loading:invisible">
          {{ text | escape }}
          {%- unless hide_icon -%}
            <span class="inline-flex items-center justify-center rounded-full bg-foreground p-1">
              {%- render 'icon', icon: 'arrow-up-right', size: icon_size, class: 'text-background transition-transform duration-150 group-hover:rotate-45' -%}
            </span>
          {%- endunless -%}
        </span>
        <span class="[grid-area:stack] size-[1em] rounded-full border-2 border-current border-t-transparent animate-spin invisible group-data-loading:visible" aria-hidden="true"></span>
      </span>
    {%- endif -%}
  </a>
{%- else -%}
  <button
    type="{{ resolved_type }}"
    class="{{ all_classes }}"
    {%- if id != blank %} id="{{ id }}"{% endif -%}
    {%- if ref != blank %} ref="{{ ref }}"{% endif -%}
    {%- if attrs != blank %} {{ attrs }}{% endif -%}
    {%- if aria_label != blank %} aria-label="{{ aria_label | escape }}"{% endif -%}
    {%- if name != blank %} name="{{ name }}" value="{{ value }}"{% endif -%}
    {%- if is_loading %} aria-busy="true" data-loading=""{% endif -%}
    {%- if is_disabled or is_loading %} disabled{% endif -%}
  >
    {%- if icon != blank -%}
      <span class="grid [grid-template-areas:'stack'] place-items-center">
        <span class="[grid-area:stack] group-data-loading:invisible">
          {%- render 'icon', icon: icon, size: icon_size -%}
        </span>
        <span class="[grid-area:stack] size-[1em] rounded-full border-2 border-current border-t-transparent animate-spin invisible group-data-loading:visible" aria-hidden="true"></span>
      </span>
    {%- else -%}
      <span class="grid [grid-template-areas:'stack'] place-items-center">
        <span class="[grid-area:stack] inline-flex items-center gap-2 group-data-loading:invisible">
          {{ text | escape }}
          {%- unless hide_icon -%}
            <span class="inline-flex items-center justify-center rounded-full bg-foreground p-1">
              {%- render 'icon', icon: 'arrow-up-right', size: icon_size, class: 'text-background transition-transform duration-150 group-hover:rotate-45' -%}
            </span>
          {%- endunless -%}
        </span>
        <span class="[grid-area:stack] size-[1em] rounded-full border-2 border-current border-t-transparent animate-spin invisible group-data-loading:visible" aria-hidden="true"></span>
      </span>
    {%- endif -%}
  </button>
{%- endif -%}
