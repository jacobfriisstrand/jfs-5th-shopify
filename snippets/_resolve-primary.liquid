{% doc %}
  Resolves whether the given product should be rendered as a group tile on
  a collection grid. Returns the literal string `true` or `false`; callers
  inspect the rendered output via `{% capture %}` + `contains`.

  See ADR-0004 for the colour-as-product model: each colour is its own
  Shopify product, grouped via a `color_group` metaobject. The collection
  grid renders one tile per group (the group's `primary_product`).

  Fallback behaviour:
  - Product has no `color_group` metafield → render as its own tile.
  - Group has no `primary_product` → render the first entry alphabetically.

  @param {product} product - The product being iterated.

  @example
  {% for product in collection.products -%}
    {%- capture should_render -%}
      {%- render '_resolve-primary', product: product -%}
    {%- endcapture -%}
    {%- if should_render contains 'true' -%}
      <li>{% render 'product-card', product: product %}</li>
    {%- endif -%}
  {%- endfor %}
{% enddoc %}

{%- liquid
  assign group = product.metafields.custom.color_group.value
  if group == blank
    assign render = true
  else
    assign primary = group.primary_product.value
    if primary == blank
      assign first = group.entries.value | sort: 'handle' | first
      assign render = false
      if first != blank and product.id == first.id
        assign render = true
      endif
    else
      assign render = false
      if product.id == primary.id
        assign render = true
      endif
    endif
  endif
-%}{{ render }}
