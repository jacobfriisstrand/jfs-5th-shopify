{% doc %}
  The `close` icon (X) as a complete inline `<svg>`. Render via the
  `icon` wrapper rather than directly: `{% render 'icon', icon: 'close' %}`.

  @param {number} [size] - Width and height in pixels. Defaults to 16.
  @param {string} [icon_class] - Extra CSS classes for the `<svg>`.
{% enddoc %}

{%- assign icon_size = size | default: 16 -%}
{%- assign icon_extra_class = icon_class | default: '' -%}

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  focusable="false"
  aria-hidden="true"
  class="icon icon-close{% if icon_extra_class != '' %} {{ icon_extra_class }}{% endif %}"
>
  <line x1="6" y1="6" x2="18" y2="18" />
  <line x1="18" y1="6" x2="6" y2="18" />
</svg>
