{%- doc -%}
  Entry/exit motion for the full-screen password dialog, plus the flex chain
  that stretches the main content between the top and the footer. Rendered
  from layout/password.liquid (layouts cannot use the stylesheet tag directly).

  Positioning and layout live in the markup as Tailwind utilities; this file
  only owns motion (keyed on the `.password-dialog` class) and the
  `.shopify-section` wrapper stretching, which markup cannot target.
  `<dialog-component>` adds `.dialog-closing` before awaiting animationend
  and calling `dialog.close()`, so the exit must be a keyframe animation.
{%- enddoc -%}

{% stylesheet %}
  .password-main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .password-main-content > .shopify-section {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  dialog.password-dialog[open]:not(.dialog-closing) {
    animation: password-fade-in var(--motion-overlay-in-duration)
      var(--motion-overlay-in-easing);
  }

  dialog.password-dialog.dialog-closing {
    animation: password-fade-out var(--motion-overlay-out-duration)
      var(--motion-overlay-out-easing) forwards;
  }

  @keyframes password-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes password-fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
{% endstylesheet %}
