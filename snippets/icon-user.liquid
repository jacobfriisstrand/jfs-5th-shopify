{% doc %}
  The `user` icon as a complete inline `<svg>`. Render via the `icon`
  wrapper rather than directly: `{% render 'icon', icon: 'user' %}`.

  @param {number} [size] - Width and height in pixels. Defaults to 16.
  @param {string} [icon_class] - Extra CSS classes for the `<svg>`.
{% enddoc %}

{%- assign icon_size = size | default: 16 -%}
{%- assign icon_extra_class = icon_class | default: '' -%}

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 16 16"
  focusable="false"
  aria-hidden="true"
  class="icon icon-user{% if icon_extra_class != '' %} {{ icon_extra_class }}{% endif %}"
>
  <circle cx="8" cy="5.5" r="2.75" fill="none" stroke="currentColor" stroke-width="1.5" />
  <path
    d="M2.75 13.75c0-2.9 2.35-4.75 5.25-4.75s5.25 1.85 5.25 4.75"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
  />
</svg>
