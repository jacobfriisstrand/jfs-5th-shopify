{% comment %}
  Page transition overlay — two-layer system:

    1. Departing page: intercept same-origin link clicks.
       Backdrop blur builds immediately → overlay slides up from bottom
       while blur is still in progress → navigate.

    2. Arriving page: only animates when arriving from an internal
       navigation (sessionStorage flag).  On first load / reload the
       overlay is hidden instantly.

  Both layers start with the `hidden` attribute so the UA stylesheet's
  `[hidden] { display: none }` hides them before any CSS loads — no
  FOUC, no stuck overlay if the author stylesheet is late.
{% endcomment %}

<div
  id="PageTransitionBlur"
  class="page-transition-blur"
  hidden
  aria-hidden="true"
></div>

<div
  id="PageTransitionOverlay"
  class="page-transition-overlay"
  hidden
  aria-hidden="true"
></div>

<script>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var blur = document.getElementById('PageTransitionBlur');
    var overlay = document.getElementById('PageTransitionOverlay');
    if (!blur || !overlay) return;

    /* ---- Phase 1: departing page — blur then cover ---- */
    document.addEventListener('click', function (e) {
      var link = e.target.closest('a');
      if (!link || !link.href) return;
      if (link.hasAttribute('data-header-cart')) return;
      if (link.target && link.target !== '_self') return;
      if (link.getAttribute('download') != null) return;

      var url;
      try { url = new URL(link.href); }
      catch (_) { return; }

      if (url.origin !== window.location.origin) return;
      if (url.pathname === window.location.pathname
          && url.search === window.location.search) {
        return;
      }

      e.preventDefault();

      /* Show blur backdrop (900 ms transition in). */
      blur.hidden = false;
      blur.offsetHeight;
      blur.classList.add('active');

      /* Overlay starts sliding up before blur finishes.
         animation-delay: 150 ms (CSS) — heavy overlap with blur. */
      overlay.classList.remove('reveal');
      overlay.hidden = false;
      overlay.offsetHeight;
      overlay.classList.add('cover');

      /* After cover finishes, flag the navigation then navigate. */
      overlay.addEventListener('animationend', function onCoverEnd(e) {
        if (e.animationName !== 'page-transition-cover') return;
        overlay.removeEventListener('animationend', onCoverEnd);
        sessionStorage.setItem('page-transition', '1');
        window.location.href = link.href;
      });
    });

    /* ---- Phase 2: arriving page — slide-down reveal (only after
         internal navigation) ---- */
    var shouldReveal = sessionStorage.getItem('page-transition') === '1';
    sessionStorage.removeItem('page-transition');

    if (!shouldReveal) {
      /* Elements already hidden (attribute).  Belt-and-suspenders. */
      blur.hidden = true;
      overlay.hidden = true;
      return;
    }

    blur.hidden = false;
    blur.classList.add('active');
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {

        var revealDone = false;
        function cleanup() {
          if (revealDone) return;
          revealDone = true;
          blur.classList.remove('active');
          blur.removeEventListener('transitionend', onBlurEnd);
          blur.hidden = true;
          overlay.removeEventListener('animationend', onRevealEnd);
          overlay.hidden = true;
        }

        function onBlurEnd() {
          blur.hidden = true;
        }

        /* Safety net: if the reveal animation never fires (author
           stylesheet not loaded, interrupted by another transition,
           etc.), force-hide after 2 s so the page isn't stuck. */
        setTimeout(cleanup, 2000);

        /* Start blur fade-out while the slide is still in progress.
           overlay reveal = 920 ms. Start blur removal at 350 ms
           so they overlap for most of the reveal. */
        setTimeout(function () {
          if (revealDone) return;
          blur.classList.remove('active');
          blur.addEventListener('transitionend', onBlurEnd);
        }, 350);

        function onRevealEnd(e) {
          if (e.animationName !== 'page-transition-reveal') return;
          cleanup();
        }
        overlay.addEventListener('animationend', onRevealEnd);
        overlay.classList.add('reveal');
        overlay.hidden = false;
      });
    });
  })();
</script>
