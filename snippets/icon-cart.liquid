{% doc %}
  The `cart` icon as a complete inline `<svg>`. Render via the `icon`
  wrapper rather than directly: `{% render 'icon', icon: 'cart' %}`.

  @param {number} [size] - Width and height in pixels. Defaults to 16.
  @param {string} [icon_class] - Extra CSS classes for the `<svg>`.
{% enddoc %}

{%- assign icon_size = size | default: 16 -%}
{%- assign icon_extra_class = icon_class | default: '' -%}

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 16 16"
  focusable="false"
  aria-hidden="true"
  class="icon icon-cart{% if icon_extra_class != '' %} {{ icon_extra_class }}{% endif %}"
>
  <path
    d="M1.5 2.5h1.6l.6 2m0 0 1.4 5.5a1 1 0 0 0 1 .75h5.6a1 1 0 0 0 1-.72l1.3-4.78H3.7Z"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <circle cx="6" cy="13" r="1" fill="currentColor" />
  <circle cx="11.5" cy="13" r="1" fill="currentColor" />
</svg>
