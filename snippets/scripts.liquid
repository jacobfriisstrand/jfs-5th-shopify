{% comment %}
  scripts.liquid — minimal commerce-essential JS bootstrap.

  Each script in src/scripts/ compiles to assets/<name>.js (esbuild type-strip,
  no bundling). The importmap below maps `@theme/*` specifiers used by source
  imports to those built assets at runtime. The tags below register the custom
  elements that need to be available on every page.

  Add a new script:
    1. drop a file in src/scripts/<name>.ts
    2. if it's imported by another script, add it to the importmap below
    3. if it registers a custom element used in liquid, add a <script src=…>
{% endcomment %}

<script type="importmap">
  {
    "imports": {
      "@theme/component":                    "{{ 'component.js'                    | asset_url }}",
      "@theme/dialog":                       "{{ 'dialog.js'                       | asset_url }}",
      "@theme/dom-events":                   "{{ 'dom-events.js'                   | asset_url }}",
      "@theme/events":                       "{{ 'events.js'                       | asset_url }}",
      "@theme/geometry":                     "{{ 'geometry.js'                     | asset_url }}",
      "@theme/morph":                        "{{ 'morph.js'                        | asset_url }}",
      "@theme/performance":                  "{{ 'performance.js'                  | asset_url }}",
      "@theme/predictive-search":            "{{ 'predictive-search.js'            | asset_url }}",
      "@theme/scheduling":                   "{{ 'scheduling.js'                   | asset_url }}",
      "@theme/section-renderer":             "{{ 'section-renderer.js'             | asset_url }}",
      "@theme/swiper-loader":                "{{ 'swiper-loader.js'                | asset_url }}",
      "@theme/utilities":                    "{{ 'utilities.js'                    | asset_url }}",
      "@theme/viewport":                     "{{ 'viewport.js'                     | asset_url }}",
      "@theme/cart-drawer":                  "{{ 'cart-drawer.js'                  | asset_url }}"
    }
  }
</script>

{% comment %} Preload the core framework modules. {% endcomment %}
<link rel="modulepreload" href="{{ 'component.js'         | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'scheduling.js'        | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'dom-events.js'        | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'events.js'            | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'morph.js'             | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'section-renderer.js'  | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'section-hydration.js' | asset_url }}" fetchpriority="low">

{% comment %}
  Cross-route custom-element registrations only.

  Commerce-specific elements (<product-form>, <variant-picker>, <product-price>,
  <quantity-selector>) are registered by the SECTIONS that emit them — not
  globally — so routes that don't render those elements don't pay the byte cost.
  See ADR-0003 pillar 7 (defer-load) and docs/perf-budget.md.
{% endcomment %}
<script src="{{ 'popover-polyfill.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'dialog.js'           | asset_url }}" type="module" fetchpriority="low"></script>

{% if request.design_mode %}
  <script src="{{ 'theme-editor.js' | asset_url }}" type="module"></script>
{% endif %}

{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
  <script src="{{ 'localization.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% endif %}

<script>
  const Theme = {
    translations: {
      placeholder_image: `{{ 'content.placeholder_image' | t }}`,
      added: `{{ 'actions.added' | t }}`,
    },
    routes: {
      cart_add_url: '{{ routes.cart_add_url | append: '.js' }}',
      cart_change_url: '{{ routes.cart_change_url }}',
      cart_update_url: '{{ routes.cart_update_url }}',
      cart_url: '{{ routes.cart_url }}',
      predictive_search_url: '{{ routes.predictive_search_url }}',
      search_url: '{{ routes.search_url }}',
    },
    template: {
      name: '{{ template }}',
    },
  };
</script>
