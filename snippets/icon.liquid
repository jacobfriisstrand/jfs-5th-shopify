{% doc %}
  Renders an icon as an inline SVG, sized to a 1:1 box.

  Each icon lives in its own snippet named `icon-<name>.liquid` (e.g.
  `snippets/icon-search.liquid`) and is the complete `<svg>` element with
  its own native `viewBox`. This wrapper passes the desired pixel `size`
  to the icon snippet via a `size` variable, and the icon snippet uses
  it for its `width` and `height` attributes. SVG's default
  `preserveAspectRatio="xMidYMid meet"` then ensures the icon fits the
  square box without stretching.

  To add a new icon: drop a `snippets/icon-<name>.liquid` file with the
  full `<svg>` markup (using `{{ size | default: 16 }}` for width/height
  and `{{ icon_class }}` for extra classes), then add a matching `when`
  branch to the case statement below. Snippet names in `{% render %}`
  must be string literals in Liquid, hence the explicit dispatch.

  @param {string} icon - Name of the icon to render. One of: `search`,
    `cart`, `user`, `error`, `close`.
  @param {number} [size] - Width and height of the box in pixels.
    Defaults to 16.
  @param {string} [class] - Extra CSS classes to add to the `<svg>`.

  @example
  {% render 'icon', icon: 'search' %}
  {% render 'icon', icon: 'cart', size: 24, class: 'text-fg' %}
{% enddoc %}

{%- case icon -%}
  {%- when 'search' -%}
    {%- render 'icon-search', size: size, icon_class: class -%}
  {%- when 'cart' -%}
    {%- render 'icon-cart', size: size, icon_class: class -%}
  {%- when 'user' -%}
    {%- render 'icon-user', size: size, icon_class: class -%}
  {%- when 'error' -%}
    {%- render 'icon-error', size: size, icon_class: class -%}
  {%- when 'close' -%}
    {%- render 'icon-close', size: size, icon_class: class -%}
{%- endcase -%}
