{% liquid
  assign variant = product.selected_or_first_available_variant
%}

<product-price
  data-block-id="{{ block.id }}"
  data-product-id="{{ product.id }}"
>
  <div ref="priceContainer" class="text-2xl font-heading font-medium">
    {%- if variant.compare_at_price > variant.price -%}
      <span class="text-foreground/60 line-through me-2">
        <span class="sr-only">{{ 'content.price_regular' | t }}: </span>
        {{- variant.compare_at_price | money_without_trailing_zeros -}}
      </span>
      <span>
        <span class="sr-only">{{ 'content.price_sale' | t }}: </span>
        {{- variant.price | money_without_trailing_zeros -}}
      </span>
    {%- else -%}
      {{ variant.price | money_without_trailing_zeros }}
    {%- endif -%}
  </div>
</product-price>

{% schema %}
{
  "name": "t:names.product_price",
  "tag": null
}
{% endschema %}
