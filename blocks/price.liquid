{% liquid
  assign variant = product.selected_or_first_available_variant
  assign registration = product.metafields.custom.participant_fields.value
  assign registration_mode = registration.mode.value | default: registration.mode
  assign team_size = product.metafields.custom.team_size | default: 1
%}

<product-price
  data-block-id="{{ block.id }}"
  data-product-id="{{ product.id }}"
>
  <div ref="priceContainer" class="flex gap-2 items-baseline">
    {%- if variant.compare_at_price > variant.price -%}
      <span class="text-foreground/60 line-through me-2">
        <span class="sr-only">{{ 'content.price_regular' | t }}: </span>
        {{- variant.compare_at_price | money_without_trailing_zeros -}}
      </span>
      <span>
        <span class="sr-only">{{ 'content.price_sale' | t }}: </span>
        {{- variant.price | money_without_trailing_zeros -}}
      </span>
    {%- else -%}
      <span class="text-2xl font-heading font-medium">{{ variant.price | money_without_trailing_zeros }}</span>
    {%- endif -%}
    {%- if registration != blank and registration_mode == 'team' and team_size > 1 -%}
      <p class="text-foreground/70 text-xs">{{ 'products.product.per_person' | t }}</p>
    {%- endif -%}
  </div>
</product-price>

{% schema %}
{
  "name": "t:names.product_price",
  "tag": null
}
{% endschema %}
