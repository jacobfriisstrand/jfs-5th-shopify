{% doc %}
  Cart summary: subtotal, tax/shipping note, "Update cart" and "Check out"
  submit buttons. Renders inside the `<form>` opened by
  `sections/main-cart.liquid` (action="/cart", method="post"), so the
  buttons submit that form by default. `name="checkout"` redirects to the
  checkout flow; `name="update"` posts updated `updates[<key>]` quantities
  back to `/cart`.
{% enddoc %}

{% liquid
  assign subtotal_label = 'content.cart_subtotal' | t
  assign savings_label = 'content.discount_savings' | t
  assign taxes_note = 'content.taxes_at_checkout_shipping_at_checkout_without_policy_without_discounts' | t
  assign update_label = 'content.update_cart' | t
  assign checkout_label = 'content.checkout' | t
  assign total_savings = cart.original_total_price | minus: cart.total_price
%}

<section class="border-current/15 mt-6 flex flex-col gap-4 border-t pt-6">
  {%- if cart.cart_level_discount_applications.size > 0 -%}
    <ul role="list" class="text-foreground/70 flex flex-col gap-1 text-sm">
      {%- for application in cart.cart_level_discount_applications -%}
        <li class="flex items-baseline justify-between gap-4">
          <span>{{ application.title }}</span>
          <span>−{{ application.total_allocated_amount | money_without_trailing_zeros }}</span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
  {%- if total_savings > 0 -%}
    <dl class="flex items-baseline justify-between gap-4 text-sm">
      <dt class="text-foreground/70">{{ savings_label }}</dt>
      <dd class="text-foreground font-medium">−{{ total_savings | money_without_trailing_zeros }}</dd>
    </dl>
  {%- endif -%}
  <dl class="flex items-baseline justify-between gap-4">
    <dt class="text-foreground text-base font-medium">{{ subtotal_label }}</dt>
    <dd class="text-foreground group text-lg font-medium" data-cart-subtotal>
      <span class="group-data-[updating=true]:hidden">{{ cart.total_price | money_without_trailing_zeros }}</span>
      {% render 'skeleton', class: 'hidden h-5 w-20 align-middle group-data-[updating=true]:inline-block' %}
    </dd>
  </dl>
  <p class="text-foreground/70 text-xs">{{ taxes_note }}</p>
  <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
    <noscript>
      {% render 'button',
        text: update_label,
        type: 'submit',
        name: 'update',
        value: '',
        variant: 'secondary'
      %}
    </noscript>
    {% render 'button',
      text: checkout_label,
      type: 'submit',
      name: 'checkout',
      value: '',
      variant: 'primary'
    %}
  </div>
</section>

{% schema %}
{
  "name": "t:names.summary",
  "tag": null
}
{% endschema %}
