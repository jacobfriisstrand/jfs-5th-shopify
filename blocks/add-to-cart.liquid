{% doc %}
  Renders the PDP add-to-cart form, wired to `<product-form-component>` for
  client-side cart submission. Falls back to a native POST to `routes.cart_add_url`
  when JavaScript is disabled.

  Used by `sections/main-product.liquid` via
  `{% content_for 'block', type: 'add-to-cart' %}`. Variant selection is
  delegated to a future variant-picker block (slice 8); for now the form posts
  the currently selected or first-available variant.
{% enddoc %}

{% liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
  if variant.available
    assign btn_text = 'actions.add_to_cart' | t
    assign btn_disabled = false
  else
    assign btn_text = 'blocks.sold_out' | t
    assign btn_disabled = true
  endif
%}

<product-form-component
  class="block"
  data-product-id="{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
>
  <form
    id="{{ form_id }}"
    action="{{ routes.cart_add_url }}"
    method="post"
    enctype="multipart/form-data"
    on:submit="product-form-component/handleSubmit"
  >
    <input type="hidden" name="form_type" value="product">
    <input type="hidden" name="utf8" value="✓">
    <input
      ref="variantId"
      type="hidden"
      name="id"
      value="{{ variant.id }}"
    >

    <add-to-cart-component>
      {% render 'button',
        text: btn_text,
        type: 'submit',
        variant: 'noIcon',
        class: 'w-full',
        disabled: btn_disabled,
        ref: 'addToCartButton'
      %}
    </add-to-cart-component>

    <div
      ref="liveRegion"
      role="status"
      aria-live="polite"
      class="sr-only"
    ></div>
  </form>
</product-form-component>

{% schema %}
{
  "name": "t:names.add_to_cart",
  "tag": null
}
{% endschema %}
