{%- liquid
  assign logo = settings.logo
  assign logo_width = settings.logo_width | default: 120
  assign is_home = false
  if request.page_type == 'index'
    assign is_home = true
  endif
-%}

{%- if is_home -%}
  <span data-header-logo class="inline-flex items-center">
{%- else -%}
  <a
    href="{{ routes.root_url }}"
    rel="home"
    data-header-logo
    class="inline-flex items-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
  >
{%- endif -%}
  {%- if logo != blank -%}
    {{
      logo
      | image_url: width: 600
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        widths: '120, 240, 360, 480, 600',
        sizes: logo_width | append: 'px',
        alt: shop.name,
        style: 'width:' | append: logo_width | append: 'px;height:auto;'
    }}
  {%- else -%}
    <span>{{ shop.name }}</span>
  {%- endif -%}
{%- if is_home -%}
  </span>
{%- else -%}
  </a>
{%- endif -%}

{% schema %}
{
  "name": "t:names.logo",
  "tag": null
}
{% endschema %}
