{% liquid
  assign logo = settings.logo
%}

<a
  href="{{ routes.root_url }}"
  rel="home"
  data-header-logo
  class="inline-flex items-center focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-foreground"
>
  {%- if logo != blank -%}
    {% render 'image',
      image: logo,
      priority: 'lcp',
      widths: '120, 240, 360, 480, 600',
      width_max: 600,
      sizes: '120px',
      alt: shop.name,
      class: 'w-12 lg:w-17 h-auto'
    %}
  {%- else -%}
    <span>{{ shop.name }}</span>
  {%- endif -%}
</a>

{% schema %}
{
  "name": "t:names.logo",
  "tag": null
}
{% endschema %}
