{% doc %}
  Header cart icon. Renders as an `<a href>` link to `/cart` per ADR-0005.

  Slice 1 ships the bare anchor (works with JS disabled). Slice 11 will
  attach a JS click handler to open the cart drawer instead of navigating;
  the anchor remains the JS-disabled fallback.

  @example
  {% content_for 'block', type: '_header-cart', id: 'header-cart' %}
{% enddoc %}

{% liquid
  assign cart_label = 'accessibility.cart' | t
%}

<div class="relative inline-flex">
  {% render 'button',
    icon: 'cart',
    icon_size: 24,
    variant: 'icon',
    href: routes.cart_url,
    aria_label: cart_label,
    attrs: 'data-header-cart'
  %}
  <span
    data-cart-badge
    aria-hidden="true"
    class="bg-brand pointer-events-none absolute -top-0.5 -right-0.5 size-2 rounded-full animate-pulse {% if cart.item_count == 0 %}hidden{% endif %}"
  ></span>
</div>

<script src="{{ 'header-cart.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% schema %}
{
  "name": "t:names.cart",
  "tag": null
}
{% endschema %}
