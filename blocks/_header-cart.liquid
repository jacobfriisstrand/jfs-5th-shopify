{% doc %}
  Header cart icon. Renders as an `<a href>` link to `/cart` per ADR-0005.

  Slice 1 ships the bare anchor (works with JS disabled). Slice 11 will
  attach a JS click handler to open the cart drawer instead of navigating;
  the anchor remains the JS-disabled fallback.

  @example
  {% content_for 'block', type: '_header-cart', id: 'header-cart' %}
{% enddoc %}

<a
  href="{{ routes.cart_url }}"
  data-header-cart
  aria-label="{{ 'accessibility.cart' | t }}"
  class="relative inline-flex items-center gap-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
>
  {%- render 'icon', icon: 'cart', size: 24 -%}
  <span class="visually-hidden">{{ 'accessibility.cart' | t }}</span>
  <span aria-hidden="true" data-cart-count>{{ cart.item_count }}</span>
  <span class="visually-hidden" data-cart-count-a11y>
    {{- 'accessibility.cart_count' | t -}}: {{ cart.item_count -}}
  </span>
</a>

<script src="{{ 'header-cart.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% schema %}
{
  "name": "t:names.cart",
  "tag": null
}
{% endschema %}
