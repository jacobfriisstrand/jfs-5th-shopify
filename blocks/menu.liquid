{% comment %}
  menu: renders a Shopify navigation linklist (configured in admin under
  Online Store → Navigation) as an inline list of links. The same block is
  used for header and footer navigation; the merchant picks which linklist
  via the `menu` setting in the theme editor.

  The `<ul>` markup is owned by `snippets/menu-list.liquid` so header and
  footer navigations stay byte-identical at the link level.
{% endcomment %}

{%- assign linklist = linklists[block.settings.menu] -%}
{%- if linklist != blank and linklist.links.size > 0 -%}
  {%- assign nav_label = block.settings.heading | default: linklist.title -%}
  <nav data-menu aria-label="{{ nav_label | escape }}" class="flex flex-col gap-3">
    {%- if block.settings.heading != blank -%}
      <h2 class="text-sm font-semibold uppercase tracking-wide">{{ block.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- render 'menu-list',
      linklist: linklist,
      list_classes: 'flex flex-col gap-2 text-sm',
      link_classes: 'underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2'
    -%}
  </nav>
{%- endif -%}

{% schema %}
{
  "name": "t:names.menu",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:content.heading"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:content.menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "t:names.menu"
    }
  ]
}
{% endschema %}
