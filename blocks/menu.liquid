{% comment %}
  menu: renders a Shopify navigation linklist (configured in admin under
  Online Store → Navigation) as an inline list of links. The same block is
  used for header and footer navigation; the merchant picks which linklist
  via the `menu` setting in the theme editor.

  The `<ul>` markup is owned by `snippets/menu-list.liquid` so header and
  footer navigations stay byte-identical at the link level.
{% endcomment %}

{% liquid
  assign linklist = linklists[block.settings.menu]
  assign nav_label = linklist.title
  assign show_legal_links = block.settings.show_legal_links
  assign privacy_policy = blank
  for policy in shop.policies
    if policy.url contains 'privacy-policy'
      assign privacy_policy = policy
      break
    endif
  endfor

  assign cookie_policy = blank
  for policy in shop.policies
    if policy.url contains 'shopifyReshowConsentBanner'
      assign cookie_policy = policy
      break
    endif
  endfor
%}

{%- if linklist != blank and linklist.links.size > 0 -%}
  <nav data-menu aria-label="{{ nav_label | escape }}" class="flex flex-col gap-2">
    {%- render 'menu-list', linklist: linklist, list_classes: 'flex flex-col gap-2 text-sm', link_classes: 'link' -%}
    {%- if show_legal_links -%}
      {%- if privacy_policy != blank or cookie_policy != blank -%}
        <ul role="list" class="flex flex-col gap-2 text-sm">
          {%- if privacy_policy != blank -%}
            <li>
              <a
                href="{{ privacy_policy.url }}"
                class="link"
              >
                {{- privacy_policy.title -}}
              </a>
            </li>
          {%- endif -%}
          {%- if cookie_policy != blank -%}
            <li>
              <a
                href="{{ cookie_policy.url }}"
                class="link"
              >
                {{- cookie_policy.title -}}
              </a>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    {%- endif -%}
  </nav>
{%- endif -%}

{% schema %}
{
  "name": "t:names.menu",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:content.menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_legal_links",
      "label": "t:content.show_legal_links",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:names.menu"
    }
  ]
}
{% endschema %}
