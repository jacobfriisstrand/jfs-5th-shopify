{% doc %}
  Single navigation link rendered as a list item.

  Designed to be a child of `_header-menu` (top level) or
  `_header-menu-column` (inside a megamenu column).

  @param {string} [label] - Visible link text. Required for the link to render.
  @param {string} [url] - Destination. Required for the link to render.
{% enddoc %}

{% liquid
  assign label = block.settings.label
  assign url = block.settings.url
%}

{%- if label != blank and url != blank -%}
  <li>
    {% render 'link',
      text: label,
      href: url,
      aria_current: true
    %}
  </li>
{%- endif -%}

{% schema %}
{
  "name": "t:names.header_menu_link",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:content.label"
    },
    {
      "type": "url",
      "id": "url",
      "label": "t:content.url"
    }
  ],
  "presets": [
    {
      "name": "t:names.header_menu_link"
    }
  ]
}
{% endschema %}
