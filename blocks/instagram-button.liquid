{% doc %}
  Renders a call-to-action button linked to an external profile.

  @param {string} [text] - Visible button label. Required to render.
  @param {string} [url] - Destination URL. Required to render.
{% enddoc %}

{% liquid
  assign text = block.settings.text
  assign url = block.settings.url
%}

{%- if text != blank and url != blank -%}
  {% render 'button', text: text, href: url, variant: 'base' %}
{%- endif -%}

{% schema %}
{
  "name": "t:names.button",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:content.label"
    },
    {
      "type": "url",
      "id": "url",
      "label": "t:settings.instagram_url"
    }
  ],
  "presets": [
    {
      "name": "t:names.button"
    }
  ]
}
{% endschema %}
