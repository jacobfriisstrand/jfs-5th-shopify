{% doc %}
  PDP quantity stepper. Wraps `snippets/quantity-input.liquid` in a
  `<quantity-selector-component>` and associates the input with the
  add-to-cart form via the native `form="…"` attribute, so the stepper can
  live as its own block while still being submitted with cart-add.

  The `form_id` here MUST match the form id constructed in
  `blocks/add-to-cart.liquid` (`product-form-<section.id>-<add-to-cart block id>`).
  Since the add-to-cart block id is not knowable from here, this block scans
  the section's blocks for one of type `add-to-cart` and uses its id. If
  none exists the `form` attribute is omitted; the stepper still works
  visually but the posted quantity will default to 1.
{% enddoc %}

{% liquid
  assign variant = product.selected_or_first_available_variant
  assign max_qty = nil
  if variant.inventory_management != blank and variant.inventory_policy == 'deny'
    assign max_qty = variant.inventory_quantity
  endif

  assign form_id = nil
  for b in section.blocks
    if b.type == 'add-to-cart'
      assign form_id = 'product-form-' | append: section.id | append: '-' | append: b.id
      break
    endif
  endfor

  assign input_id = 'quantity-' | append: section.id | append: '-' | append: block.id
%}

<div class="flex flex-col gap-2">
  <label for="{{ input_id }}" class="text-fg/70 text-sm font-medium">
    {{ 'products.product.quantity' | t }}
  </label>
  <quantity-selector-component class="inline-block">
    {% render 'quantity-input',
      input_id: input_id,
      value: 1,
      min: 1,
      max: max_qty,
      step: 1,
      name: 'quantity',
      form_id: form_id
    %}
  </quantity-selector-component>
</div>

{% schema %}
{
  "name": "t:names.quantity",
  "tag": null
}
{% endschema %}
