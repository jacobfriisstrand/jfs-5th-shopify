{% liquid
  assign image = block.settings.image
%}

{%- if image != blank -%}
  <div class="image">
    {% render 'image', image: image, class: 'w-full' %}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:names.image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    }
  ],
  "presets": [
    {
      "name": "t:names.image"
    }
  ]
}
{% endschema %}
