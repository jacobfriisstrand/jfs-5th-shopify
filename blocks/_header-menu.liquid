{% comment %}
  Header navigation: inline horizontal menu at `md` and up, hamburger
  button that opens a `<dialog-component>` drawer below `md`.

  The desktop/mobile decision is owned by CSS media queries (Tailwind's
  `md:` variant) — no JS drives layout. This guarantees the correct
  layout on first paint at any viewport (no FOUC).
{% endcomment %}

{%- assign linklist = linklists[block.settings.menu] -%}
{%- if linklist != blank and linklist.links.size > 0 -%}
  <nav
    data-inline-menu
    aria-label="{{ linklist.title | escape }}"
    class="hidden md:block min-w-0 overflow-hidden"
  >
    {%- render 'menu-list',
      linklist: linklist,
      list_classes: 'flex flex-nowrap gap-4 text-sm whitespace-nowrap'
    -%}
  </nav>

  <button
    type="button"
    data-menu-trigger
    aria-label="{{ 'actions.open_menu' | t }}"
    aria-controls="header-menu-drawer"
    aria-expanded="false"
    class="md:hidden inline-flex items-center justify-center p-2"
  >
    <svg
      viewBox="0 0 24 24"
      width="24"
      height="24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <line x1="4" y1="6"  x2="20" y2="6" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="18" x2="20" y2="18" />
    </svg>
  </button>

  {%- capture menu_drawer_body -%}
    {%- render 'drawer-close-button',
      label: 'actions.close_menu' | t,
      class: 'ml-auto'
    -%}

    <nav data-drawer-menu class="mt-4">
      {%- render 'menu-list',
        linklist: linklist,
        list_classes: 'flex flex-col gap-4 text-base'
      -%}
    </nav>
  {%- endcapture -%}

  {%- render 'drawer',
    id: 'header-menu-drawer',
    size: '100vw',
    class: 'p-6',
    aria_label: linklist.title | escape,
    content: menu_drawer_body
  -%}
{%- endif -%}

{% schema %}
{
  "name": "t:names.menu",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:content.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
