{% comment %}
  Header search: trigger button + full-viewport <dialog> hosting a
  <predictive-search> custom element. Mirrors the menu drawer pattern.

  - Server-side: only the trigger and the empty dialog shell are rendered.
  - Client-side: <predictive-search> debounces input, fetches the
    `predictive-search` section markup with `?section_id=predictive-search`,
    and swaps the results region.
  - Accessibility: input owns role="combobox" wiring (aria-controls,
    aria-expanded, aria-activedescendant). Results region is role="listbox".
    Arrow Up/Down navigates options; Enter follows the active option;
    Escape closes the dialog.
{% endcomment %}

<button
  type="button"
  data-search-trigger
  aria-label="{{ 'actions.open_search' | t }}"
  aria-controls="header-search-dialog"
  aria-expanded="false"
  class="inline-flex items-center justify-center p-2"
>
  {%- render 'icon', icon: 'search', size: 24 -%}
</button>

{%- capture search_drawer_body -%}
  <predictive-search class="flex flex-col h-full">
    <div class="flex items-center gap-2 border-b border-foreground/10 p-4">
      <form
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        class="flex-1"
      >
        <label for="header-search-input" class="sr-only">
          {{- 'content.search_input_label' | t -}}
        </label>
        <input
          ref="input"
          id="header-search-input"
          type="search"
          name="q"
          autocomplete="off"
          spellcheck="false"
          placeholder="{{ 'placeholders.search' | t }}"
          role="combobox"
          aria-controls="header-search-results"
          aria-expanded="false"
          aria-autocomplete="list"
          class="w-full bg-transparent border-0 outline-none text-lg py-2 focus-visible:outline-2 focus-visible:outline-offset-2"
        >
      </form>
      {%- render 'drawer-close-button', label: 'actions.close_search' | t -%}
    </div>

    <div
      ref="results"
      id="header-search-results"
      role="listbox"
      aria-label="{{ 'content.search_results_label' | t }}"
      class="flex-1 overflow-auto p-4"
    ></div>
  </predictive-search>
{%- endcapture -%}

{%- render 'drawer',
  id: 'header-search-dialog',
  side: 'top',
  aria_label: 'content.search' | t,
  content: search_drawer_body
-%}

{% schema %}
{
  "name": "t:names.search_input",
  "tag": null
}
{% endschema %}
