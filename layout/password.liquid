{% liquid
  assign submit_label = 'actions.submit' | t
  assign enter_password_label = 'actions.enter_password' | t
  assign close_label = 'actions.close' | t
%}

<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- render 'stylesheets' -%}

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="flex min-h-svh flex-col">
    <main
      id="MainContent"
      class="content-for-layout password-main-content flex flex-col"
      role="main"
    >
      {{ content_for_layout }}
    </main>

    <footer>
      {% section 'password-footer' %}
    </footer>

    {%- form 'storefront_password' -%}
      <dialog-component id="password-form">
        <dialog
          ref="dialog"
          class="password-dialog fixed inset-0 m-0 h-dvh max-h-none w-screen max-w-none border-0 p-0"
          {% if form.errors %}
            open
          {% endif %}
          aria-labelledby="password-dialog-heading"
        >
          <button
            class="absolute top-0 right-0 cursor-pointer p-6"
            on:click="dialog-component/closeDialog"
            type="button"
            aria-label="{{ close_label }}"
          >
            {%- render 'icon', icon: 'close', size: 20 -%}
          </button>

          <div class="flex h-full w-full flex-col items-center justify-center gap-8 p-6">
            {% render 'heading',
              text: enter_password_label,
              level: 2,
              id: 'password-dialog-heading',
              class: 'text-2xl sm:text-3xl'
            %}

            <div class="flex w-full max-w-sm flex-col gap-4">
              <label
                for="Password"
                class="sr-only"
              >
                {{ 'placeholders.password' | t }}
              </label>

              <input
                type="password"
                name="password"
                id="Password"
                class="w-full rounded-input border border-current/20 bg-transparent px-4 py-2 placeholder:text-current/50 focus-visible:outline-2 focus-visible:outline-offset-2"
                autocomplete="current-password"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="PasswordLoginForm-password-error"
                {%- endif -%}
                placeholder="{{ 'placeholders.password' | t }}"
                autofocus
              >

              {% render 'button',
                text: submit_label,
                type: 'submit',
                class: 'w-full'
              %}

              {%- if form.errors -%}
                <p
                  id="PasswordLoginForm-password-error"
                  class="flex items-center justify-center gap-2 text-sm"
                  role="alert"
                >
                  {%- render 'icon', icon: 'error', size: 16, class: 'shrink-0' -%}
                  {{ 'content.wrong_password' | t }}
                </p>
              {%- endif -%}
            </div>
          </div>
        </dialog>
      </dialog-component>
    {%- endform -%}

    {%- render 'password-layout-styles' -%}
  </body>
</html>
