<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- render 'meta-tags' -%}
    <script>
      // Announcement-bar reload-flash guard. On reload / back-forward the
      // browser paints at scrollY 0 and only restores the previous offset
      // after first paint, so flow content at the top of the document — the
      // announcement bar — flashes on screen mid-scroll. When this history
      // entry expects a restored offset > 0 (persisted in sessionStorage on
      // pagehide), hide the bar before first paint and reveal it once the
      // offset lands. Restoring to the top, fresh navigation, or a skipped
      // restoration all end revealed: the fallback only fires while scrollY
      // is 0, where showing the bar is always correct.
      (function () {
        var key = "annbar-scroll:" + location.href;
        var saved = 0;
        try {
          saved = parseInt(sessionStorage.getItem(key), 10) || 0;
        } catch (error) {}

        var nav = performance.getEntriesByType("navigation")[0] || {};
        var expectsRestore =
          (nav.type === "reload" || nav.type === "back_forward") && saved > 0;

        function reveal() {
          document.documentElement.removeAttribute(
            "data-hide-announcement-bar"
          );
          window.removeEventListener("scroll", reveal);
        }

        if (expectsRestore) {
          document.documentElement.setAttribute(
            "data-hide-announcement-bar",
            ""
          );
          // Publish the expected offset for the pre-paint measurement script
          // below: it must derive the bar's tucked state from this instead of
          // assuming the page loads at the top, or the restored layout gets a
          // post-paint correction (a visible shift near the top and at the
          // page bottom).
          document.documentElement.setAttribute(
            "data-expected-scroll",
            String(saved)
          );
          // Paint the sticky header in its scrolled (solid) state on the
          // first frame: header.js only syncs `data-scrolled` after it loads,
          // which would fade the solid background in over the content on
          // every mid-scroll reload. header.js removes this attribute when
          // it takes over the scroll state.
          document.documentElement.setAttribute("data-header-restored", "");
          // Restoration fires a scroll event; a restore that lands on the
          // top (or is skipped entirely) fires none, hence the bounded poll.
          window.addEventListener("scroll", reveal, {
            passive: true,
            once: true,
          });
          var polls = 0;
          var poll = function () {
            if (window.scrollY !== 0 || ++polls > 60) reveal();
            else requestAnimationFrame(poll);
          };
          requestAnimationFrame(poll);
        }

        window.addEventListener("pagehide", function () {
          try {
            sessionStorage.setItem(key, String(window.scrollY));
          } catch (error) {}
        });
      })();
    </script>
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <!-- Four explicit rows: announcement bar, sticky header group, main (1fr so
       short pages still pin the footer to the bottom), footer. The header group
       must own an `auto` row — inside the old 3-row template it occupied the
       `1fr` row early in parsing (before <main> exists), stretched to the
       leftover viewport height, and the pre-paint measurement script then
       published that stretched height as --header-height, shifting every
       negative-margin hero by hundreds of pixels on first paint. -->
  <body class="grid grid-rows-[auto_auto_1fr_auto] min-h-svh">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    {% section 'announcement-bar' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>
    <script>
      // Measure the header and announcement bar before first paint so the
      // CSS vars are correct on the first frame. header.js runs as a low
      // priority module after paint and would otherwise correct
      // --header-height from the CSS default (68px) to the real height
      // (64px), shifting every negative-margin hero and sticky offset by
      // 4px on page transitions. header.ts keeps the vars updated after
      // this via ResizeObserver + scroll.
      (function () {
        var group = document.getElementById("header-group");
        if (!group) return;
        var bar = document.querySelector(".shopify-section.announcement-bar");
        var barH = bar ? bar.offsetHeight : 0;
        var barInGroup = bar ? group.contains(bar) : false;
        document.documentElement.style.setProperty(
          "--header-height",
          (barInGroup ? group.offsetHeight - barH : group.offsetHeight) + "px"
        );
        // The visible bar height is scroll-dependent (the bar tucks away as
        // the page scrolls). On a reload/back-forward the restoration may land
        // after this script runs, so derive the state from the expected
        // restored offset published by the head guard instead of assuming
        // scrollY 0 — header.js then recomputes the identical value and no
        // post-paint layout correction occurs.
        var expectedScroll = Math.max(
          parseInt(
            document.documentElement.getAttribute("data-expected-scroll"),
            10
          ) || 0,
          window.scrollY || 0
        );
        document.documentElement.style.setProperty(
          "--announcement-bar-height",
          Math.max(0, barH - expectedScroll) + "px"
        );
      })();
    </script>

    <template id="cart-drawer-template" hidden>
      {% section 'cart-drawer' %}
    </template>

    <main
      id="MainContent"
      class="content-for-layout grid gap-20 lg:gap-30{% if request.page_type == 'policy' %} prose{% endif %}"
      role="main"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    <footer>
      {% sections 'footer-group' %}
    </footer>

    {% render 'toast' %}
  </body>
</html>
