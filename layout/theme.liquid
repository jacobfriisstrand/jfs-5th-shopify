<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="grid grid-rows-[auto_1fr_auto] min-h-svh">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    {% section 'announcement-bar' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>
    <script>
      // Measure the header and announcement bar before first paint so the
      // CSS vars are correct on the first frame. header.js runs as a low
      // priority module after paint and would otherwise correct
      // --header-height from the CSS default (68px) to the real height
      // (64px), shifting every negative-margin hero and sticky offset by
      // 4px on page transitions. header.ts keeps the vars updated after
      // this via ResizeObserver + scroll.
      (function () {
        var group = document.getElementById("header-group");
        if (!group) return;
        var bar = document.querySelector(".shopify-section.announcement-bar");
        var barH = bar ? bar.offsetHeight : 0;
        var barInGroup = bar ? group.contains(bar) : false;
        document.documentElement.style.setProperty(
          "--header-height",
          (barInGroup ? group.offsetHeight - barH : group.offsetHeight) + "px"
        );
        document.documentElement.style.setProperty(
          "--announcement-bar-height",
          barH + "px"
        );
      })();
    </script>

    <template id="cart-drawer-template" hidden>
      {% section 'cart-drawer' %}
    </template>

    <main
      id="MainContent"
      class="content-for-layout grid gap-20 lg:gap-30"
      role="main"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    <footer>
      {% sections 'footer-group' %}
    </footer>

    {% render 'toast' %}
  </body>
</html>
