{
  // ──────────────────────────────────────────────────────────────────────────
  // Linter + formatter: vite-plus uses oxlint + oxfmt (`vp lint`, `vp fmt`,
  // `vp check`). The official "oxc.oxc-vscode" extension wraps both, so
  // editor diagnostics and on-save fixes always match the build.
  // These WORKSPACE settings override per-developer User settings.
  // ──────────────────────────────────────────────────────────────────────────

  // Hard-disable competing linters/formatters at the workspace level so they
  // can't produce diagnostics or rewrites that diverge from the build.
  "eslint.enable": false,
  "biome.enabled": false,
  "prettier.enable": false,

  // Format on save via the oxc extension (oxfmt). Same engine as `vp fmt`.
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",

  // Run oxlint autofixes on save in the same pass.
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },

  // Per-language: route every file type the project uses through oxc.
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  // Liquid: format via Shopify's official Liquid VS Code extension
  // (Shopify.theme-check-vscode), which bundles @shopify/prettier-plugin-liquid.
  // This extension is allowed alongside the oxc-only policy because it ONLY
  // touches `.liquid` files and does not compete with oxlint/oxfmt.
  "[liquid]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Shopify.theme-check-vscode"
  },
  "[html]": { "editor.formatOnSave": false },

  // Files
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true
}
