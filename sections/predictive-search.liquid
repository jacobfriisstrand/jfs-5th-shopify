{% comment %}
  Server-rendered predictive search results.

  Fetched by the client-side <predictive-search> custom element via
  `/search/suggest?q=…&section_id=predictive-search`. The element grafts
  the inner `[data-predictive-search-content]` region into its results
  region. We only render that single region — wrappers are stripped.

  Each option carries `role="option"` + a unique `id` so the input's
  `aria-activedescendant` can point at the keyboard-active result.
{% endcomment %}

{%- liquid
  assign products = predictive_search.resources.products
  assign terms = predictive_search.terms
  assign performed = predictive_search.performed
-%}

<div data-predictive-search-content>
  {%- if performed == false or terms == blank -%}
    <p class="text-sm opacity-70">{{ 'content.search_input_placeholder' | t }}</p>
  {%- elsif products.first == nil -%}
    <p class="text-sm">
      {{ 'content.search_results_no_results' | t: terms: terms }}
    </p>
  {%- else -%}
    <ul class="flex flex-col gap-2">
      {%- for product in products -%}
        {%- liquid
          assign result_image = product.featured_media.preview_image | default: product.featured_image
        -%}
        <li
          id="predictive-search-result-{{ forloop.index0 }}"
          role="option"
          aria-selected="false"
          data-predictive-search-result
        >
          <a
            href="{{ product.url }}"
            class="flex items-center gap-3 p-2 rounded-input hover:bg-foreground/5 focus-visible:outline-2 focus-visible:outline-offset-2 aria-selected:bg-foreground/10"
          >
            {%- if result_image -%}
              <span class="relative h-12 w-12 shrink-0 overflow-hidden rounded-input">
                {% render 'skeleton', class: 'absolute inset-0 rounded-none bg-foreground/8 animate-pulse' %}
                {% render 'image',
                  image: result_image,
                  width: 48,
                  height: 48,
                  width_max: 96,
                  class: 'relative z-10 h-full w-full object-cover'
                %}
              </span>
            {%- endif -%}
            <span class="flex-1 min-w-0">
              <span class="block truncate text-sm font-medium">{{ product.title }}</span>
              <span class="block text-xs opacity-70">{{ product.price | money_without_trailing_zeros }}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:names.predictive_search"
}
{% endschema %}
