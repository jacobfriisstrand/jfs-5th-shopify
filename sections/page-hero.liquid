{%- comment -%}
  page-hero: full-bleed hero section for page templates. Uses the 12-col
  grid (ADR-0004): the image opts into `full-bleed` (gutter-to-gutter);
  the heading sits inside the content band.

  The image is constrained to `h-[60svh]` with `object-cover` so the
  natural aspect ratio doesn't blow the section to thousands of pixels
  tall.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign image = section.settings.image
-%}

<section class="grid-12">
  {%- if image != blank -%}
    {{
      image
      | image_url: width: 3000
      | image_tag:
        class: 'full-bleed h-[60svh] w-full object-cover',
        widths: '480, 768, 1024, 1440, 1920, 2560, 3000',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        alt: image.alt
    }}
  {%- endif -%}
  {%- if heading != blank -%}
    <h2 class="span-4 md:span-8 lg:cs-1 lg:span-8 text-4xl">{{ heading }}</h2>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:names.page_hero",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Page hero"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    }
  ],
  "presets": [
    {
      "name": "t:names.page_hero"
    }
  ]
}
{% endschema %}
