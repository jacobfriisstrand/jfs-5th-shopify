{% comment %}
  Footer section.

  Dynamic block area: merchants can add any number of `menu` blocks (or
  any `@theme` block) and they render as a responsive grid of vertical
  columns — typical "fat footer" pattern.

  The bottom row (copyright + policy links) is statically rendered for
  predictability across routes.
{% endcomment %}

<div class="grid-12 py-8">
  <div class="col-content flex flex-col gap-8">
    {%- if section.blocks.size > 0 -%}
      <div data-footer-menus class="grid grid-cols-2 gap-8 md:grid-cols-4">
        {%- for block in section.blocks -%}
          {% render block %}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div
      data-footer-row
      class="flex flex-col items-start gap-4 border-t border-current/10 pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      {% content_for 'block', type: 'footer-copyright', id: 'footer-copyright' %}
      {% content_for 'block', type: 'footer-policy-list', id: 'footer-policy-list' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "menu"
    },
    {
      "type": "@theme"
    }
  ]
}
{% endschema %}
