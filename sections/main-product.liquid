{%- comment -%}
  Section-owned custom-element registrations. Required by <product-form-component>
  and <product-price> elements emitted by the add-to-cart and price blocks. Loaded
  here so routes that do not render a PDP do not pay the byte cost. See ADR-0003
  pillar 7.
{%- endcomment -%}
{% liquid
  assign accordion_details = product.metafields.custom.details
  assign accordion_product_specifications = product.metafields.custom.product_specifications
  assign accordion_care = product.metafields.custom.care
  assign accordion_shipping = product.metafields.custom.shipping
  assign has_accordion = false
  if accordion_details != blank or accordion_product_specifications != blank or accordion_care != blank or accordion_shipping != blank
    assign has_accordion = true
  endif

  capture is_event_product
    render '_is-event-product', product: product
  endcapture
  assign is_event_product = is_event_product | strip

  assign accordion_label_details = 'products.product.accordion.details' | t
  assign accordion_label_product_specifications = 'products.product.accordion.product_specifications' | t
  assign accordion_label_care = 'products.product.accordion.care' | t
  assign accordion_label_shipping = 'products.product.accordion.shipping' | t

  assign event_about = product.metafields.custom.event_about
  assign event_who_for = product.metafields.custom.event_who_for
  assign event_participate = product.metafields.custom.event_participate
  assign event_included = product.metafields.custom.event_included
  assign event_practical_info = product.metafields.custom.event_practical_info
  assign event_partners = product.metafields.custom.event_partners
  assign event_disclaimer = product.metafields.custom.event_disclaimer

  assign event_label_about = 'sections.event.about' | t
  assign event_label_who_for = 'sections.event.who_for' | t
  assign event_label_participate = 'sections.event.participate' | t
  assign event_label_included = 'sections.event.included' | t
  assign event_label_practical_information = 'sections.event.practical_information' | t
  assign event_label_partners = 'sections.event.partners' | t
  assign event_label_disclaimer = 'sections.event.disclaimer' | t
%}
<script src="{{ 'product-form.js'  | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'product-price.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'component-quantity-selector.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'variant-picker-form.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'swiper-carousel.js' | asset_url }}" type="module" fetchpriority="low"></script>

<section
  class="grid-12 py-12 sm:py-16"
  aria-labelledby="main-product-{{ section.id }}-title"
>
  <div class="col-content grid gap-8 md:grid-cols-2 md:gap-12">
    <div>
      {% render 'product-gallery', product: product %}
    </div>
    <div class="flex flex-col gap-6">
      {% content_for 'block', id: 'product-title', type: 'product-title' %}
      {% content_for 'block', id: 'bundle-offer-pill', type: 'bundle-offer-pill' %}
      {% content_for 'block', id: 'price', type: 'price' %}
      {% content_for 'block', id: 'product-description', type: 'product-description' %}
      {% content_for 'block', id: 'variant-picker', type: 'variant-picker' %}
      {% render 'product-size-guide', product: product, section_id: section.id %}
      {% content_for 'block', id: 'quantity', type: 'quantity' %}
      {% content_for 'block', id: 'add-to-cart', type: 'add-to-cart' %}
      {% content_for 'block', id: 'buy-buttons', type: 'buy-buttons' %}
      {%- if is_event_product != 'true' and has_accordion -%}
        <div class="accordion-group">
          {%- if accordion_details != blank -%}
            <details class="accordion-row">
              <summary>
                {% render 'heading',
                  text: accordion_label_details,
                  level: 3,
                  class: 'text-base font-medium'
                %}
              </summary>
              <div class="prose">{{ accordion_details | metafield_tag }}</div>
            </details>
          {%- endif -%}
          {%- if accordion_product_specifications != blank -%}
            <details class="accordion-row">
              <summary>
                {% render 'heading',
                  text: accordion_label_product_specifications,
                  level: 3,
                  class: 'text-base font-medium'
                %}
              </summary>
              <div class="prose">{{ accordion_product_specifications | metafield_tag }}</div>
            </details>
          {%- endif -%}
          {%- if accordion_care != blank -%}
            <details class="accordion-row">
              <summary>
                {% render 'heading',
                  text: accordion_label_care,
                  level: 3,
                  class: 'text-base font-medium'
                %}
              </summary>
              <div class="prose">{{ accordion_care | metafield_tag }}</div>
            </details>
          {%- endif -%}
          {%- if accordion_shipping != blank -%}
            <details class="accordion-row">
              <summary>
                {% render 'heading',
                  text: accordion_label_shipping,
                  level: 3,
                  class: 'text-base font-medium'
                %}
              </summary>
              <div class="prose">{{ accordion_shipping | metafield_tag }}</div>
            </details>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if is_event_product == 'true' -%}
        {%- if event_about != blank or event_who_for != blank or event_participate != blank or event_included != blank -%}
          <div class="accordion-group">
            {%- if event_about != blank -%}
              <details class="accordion-row" open>
                <summary>
                  {% render 'heading',
                    text: event_label_about,
                    level: 3,
                    class: 'text-base font-medium'
                  %}
                </summary>
                <div class="prose">{{ event_about | metafield_tag }}</div>
              </details>
            {%- endif -%}
            {%- if event_who_for != blank -%}
              <details class="accordion-row">
                <summary>
                  {% render 'heading',
                    text: event_label_who_for,
                    level: 3,
                    class: 'text-base font-medium'
                  %}
                </summary>
                <div class="prose">{{ event_who_for | metafield_tag }}</div>
              </details>
            {%- endif -%}
            {%- if event_participate != blank -%}
              <details class="accordion-row">
                <summary>
                  {% render 'heading',
                    text: event_label_participate,
                    level: 3,
                    class: 'text-base font-medium'
                  %}
                </summary>
                <div class="prose">{{ event_participate | metafield_tag }}</div>
              </details>
            {%- endif -%}
            {%- if event_included != blank -%}
              <details class="accordion-row">
                <summary>
                  {% render 'heading',
                    text: event_label_included,
                    level: 3,
                    class: 'text-base font-medium'
                  %}
                </summary>
                <div class="prose">{{ event_included | metafield_tag }}</div>
              </details>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if event_practical_info != blank -%}
          <div>
            {% render 'heading',
              text: event_label_practical_information,
              level: 2,
              class: 'text-xl font-medium'
            %}
            <div class="prose mt-4">{{ event_practical_info | metafield_tag }}</div>
          </div>
        {%- endif -%}

        {%- if event_partners != blank -%}
          <div>
            {% render 'heading',
              text: event_label_partners,
              level: 2,
              class: 'text-xl font-medium'
            %}
            <div class="mt-4 flex flex-wrap gap-4">
              {%- for file in event_partners.value -%}
                <div class="w-24 h-24">
                  {{ file.preview_image | image_url: width: 200 | image_tag: alt: file.alt, class: 'w-full h-full object-contain' }}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if event_disclaimer != blank -%}
          <div>
            {% render 'heading',
              text: event_label_disclaimer,
              level: 2,
              class: 'text-xl font-medium'
            %}
            <div class="prose mt-4">{{ event_disclaimer | metafield_tag }}</div>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:names.product_information",
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}
