{%- comment -%}
  Cart drawer (slice 11) — slide-over after-action affordance per ADR-0005.

  Rendered server-side inside an inert `<template>` in
  `layout/theme.liquid`. Parsed but not in the main DOM until
  `header-cart.ts` clones it on first cart interaction.
  Closed by default — the native `<dialog>` is inert until opened.
  Opened by JS in two cases only:
    1. Successful PDP add-to-cart (CartAddEvent with source =
       "product-form-component").
    2. Click on the header cart icon (`[data-header-cart]`).

  The drawer is a SUBSET of `/cart`: line items, subtotal, View cart link,
  Checkout button. No shipping calc, notes, discount, accelerated checkout.

  Defer-load: the `<cart-drawer-component>` registration script is dynamic-
  imported by `header-cart.js` on first hover/focus of the cart anchor (or
  on first PDP add). The inner `<dialog-component>` is registered globally
  in `snippets/scripts.liquid`, so the close button, backdrop click, and
  Escape key work the moment the dialog is opened — even before the outer
  wrapper has upgraded. Native `<dialog>.showModal()` provides the focus
  trap automatically per the HTML spec.

  The drawer wraps its contents in `<cart-form-component><form
  action="/cart" method="post">` so quantity changes and per-line removal
  work via the same code path as `/cart` (see `src/scripts/cart-form.ts`),
  and the form posts cleanly with JS disabled.
{%- endcomment -%}

<script src="{{ 'component-quantity-selector.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'cart-form.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% liquid
  assign drawer_title = 'content.cart_title' | t
  assign close_label = 'actions.close' | t
  assign subtotal_label = 'content.cart_subtotal' | t
  assign savings_label = 'content.discount_savings' | t
  assign taxes_note = 'content.taxes_at_checkout_shipping_at_checkout_without_policy_without_discounts' | t
  assign view_cart_label = 'actions.view_cart' | t
  assign checkout_label = 'content.checkout' | t
  assign empty_heading = 'content.your_cart_is_empty' | t
  assign continue_label = 'actions.continue_shopping' | t
  assign form_id = 'cart-drawer-form-' | append: section.id
  assign total_savings = cart.original_total_price | minus: cart.total_price
%}

<cart-drawer-component>
  {%- capture cart_drawer_body -%}
    <div class="flex h-full flex-col">
      <header class="flex items-center justify-between gap-4 border-b border-current/15 p-4">
        {% render 'heading',
          text: drawer_title,
          level: 2,
          id: 'cart-drawer-title',
          class: 'text-lg font-medium'
        %}
        {%- render 'drawer-close-button', label: close_label -%}
      </header>

      {%- if cart.item_count == 0 -%}
        <div class="flex flex-1 flex-col items-start justify-center gap-4 p-6">
          {% render 'heading',
            text: empty_heading,
            level: 3,
            class: 'text-xl font-medium'
          %}
          <a
            href="{{ routes.root_url }}"
            on:click="dialog-component/closeDialog"
            class="text-foreground underline underline-offset-4"
          >
            {{ continue_label }}
          </a>
        </div>
      {%- else -%}
        <cart-form-component class="flex flex-1 flex-col overflow-hidden">
          <form
            id="{{ form_id }}"
            action="{{ routes.cart_url }}"
            method="post"
            novalidate
            class="flex flex-1 flex-col overflow-hidden"
          >
            <div class="flex-1 overflow-y-auto px-4">
              {% render '_cart-line-items', cart: cart %}
            </div>

            <footer class="border-t border-current/15 p-4 flex flex-col gap-4">
              {%- if cart.cart_level_discount_applications.size > 0 -%}
                <ul role="list" class="text-foreground/70 flex flex-col gap-1 text-sm">
                  {%- for application in cart.cart_level_discount_applications -%}
                    <li class="flex items-baseline justify-between gap-4">
                      <span>{{ application.title }}</span>
                      <span>−{{ application.total_allocated_amount | money }}</span>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if total_savings > 0 -%}
                <dl class="flex items-baseline justify-between gap-4 text-sm">
                  <dt class="text-foreground/70">{{ savings_label }}</dt>
                  <dd class="text-foreground font-medium">−{{ total_savings | money }}</dd>
                </dl>
              {%- endif -%}
              <dl class="flex items-baseline justify-between gap-4">
                <dt class="text-foreground text-base font-medium">{{ subtotal_label }}</dt>
                <dd class="text-foreground group text-lg font-medium" data-cart-subtotal>
                  <span class="group-data-[updating=true]:hidden">{{ cart.total_price | money }}</span>
                  <span
                    aria-hidden="true"
                    class="bg-foreground/10 hidden h-5 w-20 animate-pulse rounded align-middle group-data-[updating=true]:inline-block"
                  ></span>
                </dd>
              </dl>
              <p class="text-foreground/70 text-xs">{{ taxes_note }}</p>
              <div class="flex flex-col gap-3">
                {% render 'button',
                  text: checkout_label,
                  type: 'submit',
                  name: 'checkout',
                  value: '',
                  variant: 'primary'
                %}
                {% render 'button',
                  text: view_cart_label,
                  href: routes.cart_url,
                  variant: 'secondary'
                %}
              </div>
            </footer>
          </form>
        </cart-form-component>
      {%- endif -%}
    </div>
  {%- endcapture -%}

  {%- render 'drawer',
    id: 'cart-drawer',
    aria_labelledby: 'cart-drawer-title',
    content: cart_drawer_body
  -%}
</cart-drawer-component>

{% schema %}
{
  "name": "Cart drawer",
  "tag": "aside"
}
{% endschema %}
