{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign cta_text = section.settings.cta_text
  assign cta_url = section.settings.cta_url
  assign collection = section.settings.collection
  assign products_to_show = 8
  assign actual_count = products_to_show
  if collection.products_count < actual_count
    assign actual_count = collection.products_count
  endif
  assign card_type = section.settings.card_type | default: 'product'
  assign heading_id = 'carousel-' | append: section.id
%}

<section
  class="grid-12"
  {% if heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="col-content">
    {% if collection != blank %}
      {% render 'carousel',
        type: card_type,
        items: collection.products,
        count: actual_count,
        min_for_carousel: 3,
        heading: heading,
        subheading: subheading,
        heading_id: heading_id,
        link_url: cta_url,
        link_text: cta_text
      %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:names.carousel",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "card_type",
      "label": "t:settings.card_type",
      "options": [
        {
          "value": "product",
          "label": "t:names.product_card"
        },
        {
          "value": "event",
          "label": "t:names.event_card"
        }
      ],
      "default": "product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:settings.subheading"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "t:settings.cta_text"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:settings.link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    }
  ],
  "presets": [
    {
      "name": "t:names.carousel",
      "category": "t:categories.product_list"
    }
  ]
}
{% endschema %}
