{% comment %}
  Header section.

  Responsive layout is CSS-first: the inline menu and hamburger are gated
  by Tailwind's `md:` breakpoint inside `_header-menu`. No JS-driven
  layout decision, so first paint matches the viewport — no FOUC.

  `<header-component>` still owns dialog open/close wiring for the menu
  drawer and search dialog.
{% endcomment %}

<header-component class="grid-12">
  <div
    data-header-row
    class="col-content flex items-center justify-between gap-4 py-3"
  >
    {% content_for 'block', type: '_header-logo', id: 'header-logo' %}
    {% content_for 'block', type: '_header-menu', id: 'header-menu' %}
    {% content_for 'block', type: '_header-search', id: 'header-search' %}
    {% content_for 'block', type: '_header-cart', id: 'header-cart' %}
  </div>
</header-component>

<script src="{{ 'header.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'predictive-search.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% schema %}
{
  "name": "t:names.header",
  "tag": "header"
}
{% endschema %}
