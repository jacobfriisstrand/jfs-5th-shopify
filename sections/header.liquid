{% comment %}
  Header section — slice 1 minimal: logo on the left, cart icon on the right.

  Hamburger menu (slice 2) and predictive search (slice 3) will be inserted
  here as additional blocks.
{% endcomment %}

<div
  data-header-row
  class="flex items-center justify-between gap-4 mx-auto max-w-screen-xl px-4 py-3"
>
  {% content_for 'block', type: '_header-logo', id: 'header-logo' %}
  {% content_for 'block', type: '_header-cart', id: 'header-cart' %}
</div>

{% schema %}
{
  "name": "t:names.header",
  "tag": "header"
}
{% endschema %}
