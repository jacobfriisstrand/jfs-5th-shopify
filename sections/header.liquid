{% comment %}
  Header section.

  The outer `<header-component>` custom element owns the responsive layout
  decision: it publishes `data-menu-style="menu|drawer"` on itself based on
  touch capability + inline-menu overflow, and Tailwind's
  `group-data-[menu-style=…]` variants on the children switch visibility
  without any JS-driven `display:` toggling.

  Predictive search (slice 3) and the JS cart-drawer (slice 11) will drop
  in as additional blocks/listeners later.
{% endcomment %}

<header-component
  class="group grid-12"
  data-menu-style="menu"
>
  <div
    data-header-row
    class="col-content flex items-center justify-between gap-4 py-3"
  >
    {% content_for 'block', type: '_header-logo', id: 'header-logo' %}
    {% content_for 'block', type: '_header-menu', id: 'header-menu' %}
    {% content_for 'block', type: '_header-search', id: 'header-search' %}
    {% content_for 'block', type: '_header-cart', id: 'header-cart' %}
  </div>
</header-component>

<script src="{{ 'header.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'predictive-search.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% schema %}
{
  "name": "t:names.header",
  "tag": "header"
}
{% endschema %}
