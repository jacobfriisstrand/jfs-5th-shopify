{% liquid
  assign products = collection.products
  assign heading_id = 'main-collection-' | append: section.id
%}

<section
  class="grid-12 py-12 sm:py-16"
  aria-labelledby="{{ heading_id }}"
>
  <div class="col-content flex flex-col gap-8">
    <h1 id="{{ heading_id }}" class="text-2xl font-medium sm:text-3xl">
      {{ collection.title | escape }}
    </h1>

    {%- if products.size == 0 -%}
      <p>{{ 'content.no_products_found' | t }}</p>
    {%- else -%}
      <ul role="list" class="grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-3 lg:grid-cols-4">
        {%- for product in products -%}
          {%- capture should_render -%}
            {%- render '_resolve-primary', product: product -%}
          {%- endcapture -%}
          {%- if should_render contains 'true' -%}
            <li>{% render 'product-card', product: product %}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  }
}
{% endschema %}
