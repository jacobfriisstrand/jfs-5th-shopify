{% liquid
  assign products = collection.products
  assign heading_id = 'main-collection-' | append: section.id
%}

<section
  class="grid-12"
  aria-labelledby="{{ heading_id }}"
>
  <div class="col-content">
    {%- if products.size == 0 -%}
      <p>{{ 'content.no_products_found' | t }}</p>
    {%- else -%}
      <ul role="list" class="grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-3 lg:grid-cols-4">
        {%- for product in products -%}
          {%- assign seen_colors = '||' -%}
          {%- for variant in product.variants -%}
            {%- assign color_key = '|' | append: variant.option1 | append: '|' -%}
            {%- unless seen_colors contains color_key -%}
              {%- assign seen_colors = seen_colors | append: color_key -%}
              <li>{% render 'product-card', product: product, variant: variant, heading_level: 2 %}</li>
            {%- endunless -%}
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  }
}
{% endschema %}
