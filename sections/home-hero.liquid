{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign image = section.settings.image
  assign video = section.settings.video
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
%}

<section class="relative isolate w-full overflow-hidden bg-background text-foreground">
  {%- if video != blank -%}
    <div class="absolute inset-0 -z-10 bg-black">
      {% render 'video',
        video: video,
        autoplay: true,
        loop: true,
        muted: true,
        hide_button: true,
        class: 'h-full w-full',
        video_class: 'h-full w-full object-cover'
      %}
      <div class="absolute inset-0 bg-foreground/30"></div>
    </div>
    <button
      type="button"
      data-video-toggle
      id="hero-video-toggle-{{ section.id }}"
      aria-label="{{ 'accessibility.play_video' | t }}"
      class="absolute bottom-4 right-4 z-50 flex items-center justify-center rounded-full bg-foreground/60 text-background p-3 transition-transform hover:scale-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground cursor-pointer group"
    >
      <span class="block group-data-paused:hidden">
        {%- render 'icon', icon: 'pause', size: 24, class: 'block' -%}
      </span>
      <span class="hidden group-data-paused:block">
        {%- render 'icon', icon: 'play', size: 24, class: 'block' -%}
      </span>
    </button>
    {%- if video != blank -%}
      <script>
        (function () {
          var btn = document.getElementById('hero-video-toggle-{{ section.id }}');
          var section = btn.closest('section');
          if (!section) return;
          var video = section.querySelector('video');
          if (!video) return;

          var playLabel = '{{ "accessibility.play_video" | t }}';
          var pauseLabel = '{{ "accessibility.pause_video" | t }}';

          function updateState() {
            var paused = video.paused;
            btn.setAttribute('aria-label', paused ? playLabel : pauseLabel);
            if (paused) {
              btn.setAttribute('data-paused', '');
            } else {
              btn.removeAttribute('data-paused');
            }
          }

          btn.addEventListener('click', function () {
            if (video.paused) {
              video.play();
            } else {
              video.pause();
            }
          });

          video.addEventListener('play', updateState);
          video.addEventListener('pause', updateState);
          video.addEventListener('ended', updateState);

          updateState();
        })();
      </script>
    {%- endif -%}
  {%- elsif image != blank -%}
    <div class="absolute inset-0 -z-10 bg-background">
      {% render 'image',
        image: image,
        priority: 'lcp',
        class: 'h-full w-full object-cover',
        alt_fallback: heading,
        width_max: 2400,
        widths: '480, 768, 1024, 1440, 1920, 2400',
        sizes: '100vw'
      %}
      <div class="absolute inset-0 bg-foreground/30"></div>
    </div>
  {%- endif -%}

  <div class="grid-12 py-16 sm:py-24">
    <div class="col-content flex min-h-[60vh] flex-col items-center justify-center gap-4 text-center">
      {%- if heading != blank -%}
        {% render 'heading',
          text: heading,
          level: 1,
          class: 'text-4xl font-bold leading-tight sm:text-5xl md:text-6xl'
        %}
      {%- endif -%}

      {%- if subheading != blank -%}
        <p class="max-w-2xl text-lg sm:text-xl">{{ subheading | escape }}</p>
      {%- endif -%}

      {%- if button_label != blank and button_link != blank -%}
        {% render 'button',
          text: button_label,
          href: button_link,
          variant: 'primary',
          class: '!bg-background !text-foreground mt-2 w-fit'
        %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:names.home_hero",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:settings.subheading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:names.home_hero",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
