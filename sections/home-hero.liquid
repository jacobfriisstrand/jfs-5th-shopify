{% liquid
  assign eyebrow_text = section.settings.eyebrow_text
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign image = section.settings.image
  assign video = section.settings.video
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign heading_level = section.settings.heading_heading_level | default: 1 | plus: 0
  assign eyebrow_level = section.settings.eyebrow_heading_level | default: 2 | plus: 0
%}

<section class="relative -mt-[calc(var(--header-height)+var(--announcement-bar-height,0))] isolate w-full overflow-hidden bg-background text-foreground min-h-[110dvh]">
  {%- if video != blank -%}
    <div class="absolute inset-0 -z-10 bg-black" style="background-color: #000">
      {% render 'video',
        video: video,
        autoplay: true,
        loop: true,
        muted: true,
        class: 'h-full w-full',
        video_class: 'h-full w-full object-cover'
      %}
      {% render 'image-overlay', direction: 'top', opacity: '70%' %}
      {% render 'image-overlay', direction: 'bottom', opacity: '100%' %}
    </div>
  {%- elsif image != blank -%}
    <div class="absolute inset-0 -z-10 bg-background">
      {% render 'image',
        image: image,
        priority: 'lcp',
        class: 'h-full w-full object-cover',
        alt_fallback: heading,
        width_max: 2400,
        widths: '480, 768, 1024, 1440, 1920, 2400',
        sizes: '100vw'
      %}
      {% render 'image-overlay', direction: 'top', opacity: '70%' %}
      {% render 'image-overlay', direction: 'bottom', opacity: '100%' %}
    </div>
  {%- endif -%}

  <div class="grid-12 h-dvh">
    <div class="col-content flex items-end pb-10">
      <div class="flex flex-col gap-4 lg:flex-row lg:w-full lg:justify-between lg:items-end rounded-2xl">
        <div class="flex flex-col gap-5 lg:basis-1/3">
          {%- if eyebrow_text != blank -%}
            {% render 'heading', text: eyebrow_text, level: eyebrow_level, class: 'text-base md:text-lg font-body' %}
          {%- endif -%}
          {%- if heading != blank -%}
            {% render 'heading', text: heading, level: heading_level, class: 'text-3xl lg:text-6xl' %}
          {%- endif -%}
        </div>
        <div class="lg:basis-2/5 grid gap-4">
          {%- if subheading != blank -%}
            <p>{{ subheading | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- if button_label != blank and button_link != blank -%}
            {% render 'button', text: button_label, href: button_link, variant: 'base', class: 'lg:w-fit' %}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:names.home_hero",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "t:settings.eyebrow_text"
    },
    {
      "type": "select",
      "id": "eyebrow_heading_level",
      "label": "t:settings.eyebrow_heading_level",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "H1"
        },
        {
          "value": "2",
          "label": "H2"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_heading_level",
      "label": "t:settings.heading_heading_level",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "H1"
        },
        {
          "value": "2",
          "label": "H2"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:settings.subheading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:names.home_hero",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
