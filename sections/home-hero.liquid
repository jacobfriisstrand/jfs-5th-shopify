{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign image = section.settings.image
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
%}

<section class="relative isolate w-full overflow-hidden bg-bg text-fg">
  {%- if image != blank -%}
    <div class="absolute inset-0 -z-10">
      {{
        image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          decoding: 'async',
          sizes: '100vw',
          widths: '480, 768, 1024, 1440, 1920, 2400',
          class: 'h-full w-full object-cover',
          alt: image.alt
        | default: heading
      }}
      <div class="absolute inset-0 bg-fg/30"></div>
    </div>
  {%- endif -%}

  <div class="grid-12 py-16 sm:py-24">
    <div class="col-content flex min-h-[60vh] flex-col items-center justify-center gap-4 text-center">
      {%- if heading != blank -%}
        <h1 class="font-primary text-4xl font-bold leading-tight sm:text-5xl md:text-6xl">
          {{ heading | escape }}
        </h1>
      {%- endif -%}

      {%- if subheading != blank -%}
        <p class="max-w-2xl text-lg sm:text-xl">{{ subheading | escape }}</p>
      {%- endif -%}

      {%- if button_label != blank and button_link != blank -%}
        {% render 'button',
          text: button_label,
          href: button_link,
          variant: 'primary',
          class: '!bg-bg !text-fg mt-2 w-fit'
        %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:names.home_hero",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:settings.subheading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:names.home_hero",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
