{% liquid
  assign enter_using_password_label = 'actions.enter_using_password' | t
  assign store_owner_link = 'content.store_owner_link_html' | t: link: '/admin'
%}

<div class="flex flex-col items-center gap-6 px-6 pb-12 text-center">
  {% render 'button',
    text: enter_using_password_label,
    variant: 'link',
    attrs: 'aria-haspopup="dialog" on:click="#password-form/showDialog"'
  %}

  <p class="text-sm">{{ store_owner_link }}</p>
</div>

{% schema %}
{
  "name": "t:names.footer_password"
}
{% endschema %}
