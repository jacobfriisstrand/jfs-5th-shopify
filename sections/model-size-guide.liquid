{%- comment -%}
  model-size-guide: surfaces model photos from the `model_size_guide`
  metaobject definition — the section is added to any page via the theme editor.
  Every published entry renders as a card (photo + caption); a
  single-select size filter (radio chips) shows only the entries wearing the
  chosen size. Filtering is done client-side by <model-size-guide> (see
  src/scripts/model-size-guide.ts); without JS every card stays visible.

  Expected metaobject shape (`model_size_guide`):

  - `name`: single-line text (editor-only identifier; set as the admin display
    name — not rendered on the storefront)
  - `size`: single-line text (worn size, drives the filter; limit it to
    preset choices in the metaobject definition so editors pick from a fixed
    set instead of typing). A list of single-line text also works — the
    first non-blank value is used. As with `images`, list values return nil
    for `.first` while strings return their first character, so values are
    extracted by iteration, never `.first`. Filter chips and cards render
    in the canonical order S, M, L, XL; sizes outside that set follow
    after XL in discovery order.
  - `description`: single-line text (caption, e.g.
    "Jacob is 186 cm, 86 kg and wears a size L")
  - `images`: list of file references, images only (model photos; a single
    image renders as one photo, more than one renders as a Swiper carousel
    on the card). The list value supports iteration, `.size` and the
    `| size` filter, but `.first` returns nil — extract a single image by
    looping over the list, never with `.first`.
  - `product`: product reference (optional; the product this entry's garment
    belongs to — its title renders as a link to the product page)

  Requires Storefront access on the definition (type + fields) or the
  enumeration is empty and the section renders nothing.
{%- endcomment -%}

{%- liquid
  assign entries = shop.metaobjects.model_size_guide.values
  assign label = 'sections.model_size_guide.label' | t
  assign filter_label = 'sections.model_size_guide.filter_label' | t
  assign all_sizes_label = 'sections.model_size_guide.all_sizes' | t
  assign no_results = 'sections.model_size_guide.no_results' | t
  assign count_one = 'sections.model_size_guide.model_count_one' | t
  assign count_other = 'sections.model_size_guide.model_count_other' | t: count: '__COUNT__'
  assign radio_name = 'model-size-' | append: section.id

  assign any_carousel = false
  for entry in entries
    if entry.images.value.size > 1
      assign any_carousel = true
    endif
  endfor

  if entries.size == 1
    assign initial_count = 'sections.model_size_guide.model_count_one' | t
  else
    assign initial_count = 'sections.model_size_guide.model_count_other' | t: count: entries.size
  endif

  assign size_order = 'S,M,L,XL' | split: ','
-%}

{%- assign size_list = '' -%}
{%- assign size_keys = '' -%}
{%- for entry in entries -%}
  {%- capture entry_size -%}{%- render 'model-size-guide-entry-size', entry: entry -%}{%- endcapture -%}
  {%- assign entry_size = entry_size | strip -%}
  {%- if entry_size != blank -%}
    {%- assign size_key = '|' | append: entry_size | append: '|' -%}
    {%- unless size_keys contains size_key -%}
      {%- assign size_keys = size_keys | append: size_key -%}
      {%- if size_list == '' -%}
        {%- assign size_list = entry_size -%}
      {%- else -%}
        {%- assign size_list = size_list | append: ',' | append: entry_size -%}
      {%- endif -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- assign sizes = size_list | split: ',' -%}
{%- assign ordered_sizes = '' -%}
{%- for preferred in size_order -%}
  {%- for size in sizes -%}
    {%- if size == preferred -%}
      {%- if ordered_sizes == '' -%}
        {%- assign ordered_sizes = size -%}
      {%- else -%}
        {%- assign ordered_sizes = ordered_sizes | append: ',' | append: size -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- for size in sizes -%}
  {%- unless size_order contains size -%}
    {%- if ordered_sizes == '' -%}
      {%- assign ordered_sizes = size -%}
    {%- else -%}
      {%- assign ordered_sizes = ordered_sizes | append: ',' | append: size -%}
    {%- endif -%}
  {%- endunless -%}
{%- endfor -%}
{%- assign sizes = ordered_sizes | split: ',' -%}

{%- if entries != blank -%}
  <script src="{{ 'model-size-guide.js' | asset_url }}" type="module" fetchpriority="low"></script>
  {%- if any_carousel -%}
    <script src="{{ 'swiper-carousel.js' | asset_url }}" type="module" fetchpriority="low"></script>
  {%- endif -%}

  <model-size-guide class="block">
    <section class="grid-12" aria-label="{{ label }}">
      <div class="col-content flex flex-col gap-8">
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
          <fieldset class="flex gap-2" role="radiogroup" aria-label="{{ filter_label }}">
            <legend class="sr-only">{{ filter_label }}</legend>

            {%- assign all_size_id = radio_name | append: '-all' -%}
            {% render 'sort-button',
              id: all_size_id,
              name: radio_name,
              value: '',
              text: all_sizes_label,
              checked: true
            %}

            {%- for size in sizes -%}
              {%- if size != blank -%}
                {%- assign size_chip_id = radio_name | append: '-' | append: forloop.index -%}
                {%- assign size_label = size | escape -%}
                {% render 'sort-button', id: size_chip_id, name: radio_name, value: size, text: size_label %}
              {%- endif -%}
            {%- endfor -%}
          </fieldset>

          <style>
            input[name="{{ radio_name }}"]:checked + label {
              background: var(--color-foreground);
              color: var(--color-background);
              border-color: var(--color-foreground);
            }
          </style>

          <p
            role="status"
            data-model-size-count
            data-count-one="{{ count_one }}"
            data-count-other="{{ count_other }}"
            class="text-sm text-foreground/60"
          >
            {{- initial_count -}}
          </p>
        </div>

        <div class="grid grid-cols-1 gap-12">
          {%- comment -%}
            Cards render grouped by size in canonical order (S, M, L, XL);
            sizes outside that set keep discovery order after XL.
          {%- endcomment -%}
          {%- for preferred_size in size_order -%}
            {%- for entry in entries -%}
              {%- capture entry_size -%}{%- render 'model-size-guide-entry-size', entry: entry -%}{%- endcapture -%}
              {%- assign entry_size = entry_size | strip -%}
              {%- if entry_size == preferred_size -%}
                {% render 'model-size-guide-card', entry: entry %}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
          {%- for entry in entries -%}
            {%- capture entry_size -%}{%- render 'model-size-guide-entry-size', entry: entry -%}{%- endcapture -%}
            {%- assign entry_size = entry_size | strip -%}
            {%- unless size_order contains entry_size -%}
              {% render 'model-size-guide-card', entry: entry %}
            {%- endunless -%}
          {%- endfor -%}
        </div>

        <p data-model-size-empty hidden class="text-sm text-foreground/60">{{ no_results }}</p>
      </div>
    </section>
  </model-size-guide>
{%- endif -%}

{% schema %}
{
  "name": "t:names.model_size_guide",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "presets": [
    {
      "name": "t:names.model_size_guide"
    }
  ]
}
{% endschema %}
