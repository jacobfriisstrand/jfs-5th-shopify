{% comment %} product-information: scaffold — populate as needed. {% endcomment %}

{%- comment -%}
  Section-owned custom-element registrations. Required by <product-form>,
  <variant-picker>, <product-price>, and <quantity-selector> elements that this
  section's blocks emit. See ADR-0003 pillar 7.
{%- endcomment -%}
<script src="{{ 'product-form.js'                | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'variant-picker.js'              | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'product-price.js'               | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'component-quantity-selector.js' | asset_url }}" type="module" fetchpriority="low"></script>

<div class="product-information">
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:names.product_information",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
