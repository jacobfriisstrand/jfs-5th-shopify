{% comment %}
  This section is used in the list-collections template to render a list of
  collections.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{% liquid
  assign heading_id = 'collections-' | append: section.id
  assign page_title = 'collections.title' | t
%}

<section class="grid-12 py-12 sm:py-16" aria-labelledby="{{ heading_id }}">
  <div class="col-content flex flex-col gap-8">
    {% render 'heading', text: page_title, level: 1, id: heading_id, class: 'text-3xl lg:text-5xl' %}

    <ul
      role="list"
      class="grid gap-10 lg:grid-cols-2"
    >
      {%- for collection in collections -%}
        <li>
          <a
            href="{{ collection.url }}"
            class="group grid lg:grid-cols-2 overflow-hidden rounded-input border border-foreground/10 bg-foreground/[0.03] transition-[scale,background-color,border-color] duration-150 ease-out hover:border-foreground/25 hover:bg-foreground/[0.06] active:scale-[0.99] motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
          >
            {%- if collection.featured_image != blank -%}
              <div class="aspect-3/4">
                {% render 'image',
                  image: collection.featured_image,
                  class: 'object-cover w-full h-full',
                  alt_fallback: collection.title,
                  width_max: 800,
                  widths: '200, 300, 400, 600, 800',
                  sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw'
                %}
              </div>
            {%- endif -%}
            <div class="flex flex-col gap-1 p-4">
              {% render 'heading', text: collection.title, class: 'text-base lg:text-4xl' %}
              {%- if collection.description != blank -%}
                <p class="text-sm text-foreground/60">{{ collection.description | strip_html | truncatewords: 15 }}</p>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:general.collections_grid",
  "presets": [
    {
      "name": "t:general.collections_grid"
    }
  ]
}
{% endschema %}
